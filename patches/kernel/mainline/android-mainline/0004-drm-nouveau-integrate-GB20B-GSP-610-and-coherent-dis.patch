+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+ * THE COPYRIGHT HOLDER(S) OR AUTHOR(S) BE LIABLE FOR ANY CLAIM, DAMAGES OR
+ * OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE,
+ * ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR
+ * OTHER DEALINGS IN THE SOFTWARE.
+ *
+ * Authors: Dave Airlie
+ */
+#include "priv.h"
+
+#include <nvhw/drf.h>
+#include <subdev/timer.h>
+/*
+ * MMIO-based L2 cache operations via XAL_EP and virtual function registers.
+ * GH100/GB20B have no LTC subdevice, so we use these instead of nvkm_ltc_*().
+ */
+#define NV_XAL_EP_UFLUSH_L2_FLUSH_DIRTY                                        0x0010f810
+#define NV_XAL_EP_UFLUSH_L2_FLUSH_DIRTY_TOKEN                                        30:0
+#define NV_XAL_EP_UFLUSH_L2_FLUSH_DIRTY_COMPLETED                              0x0010f814
+#define NV_XAL_EP_UFLUSH_L2_FLUSH_DIRTY_COMPLETED_TOKEN                              30:0
+#define NV_XAL_EP_UFLUSH_L2_FLUSH_DIRTY_COMPLETED_STATUS                            31:31
+#define NV_XAL_EP_UFLUSH_L2_FLUSH_DIRTY_COMPLETED_STATUS_BUSY                         0x1
+
+#define NV_VIRTUAL_FUNCTION_PRIV_FUNC_L2_SYSMEM_INVALIDATE                                    0x00B80F10   /* R--4R */
+#define NV_VIRTUAL_FUNCTION_PRIV_FUNC_L2_SYSMEM_INVALIDATE_TOKEN                   (31-1):0   /* R-IUF */
+#define NV_VIRTUAL_FUNCTION_PRIV_FUNC_L2_SYSMEM_INVALIDATE_COMPLETED                           0x00B80F14   /* R--4R */
+#define NV_VIRTUAL_FUNCTION_PRIV_FUNC_L2_SYSMEM_INVALIDATE_COMPLETED_TOKEN         (31-1):0   /* R-IUF */
+#define NV_VIRTUAL_FUNCTION_PRIV_FUNC_L2_SYSMEM_INVALIDATE_COMPLETED_STATUS                                   31:31   /* R-IUF */
+#define NV_VIRTUAL_FUNCTION_PRIV_FUNC_L2_SYSMEM_INVALIDATE_COMPLETED_STATUS_BUSY                         0x00000001   /* R---V */
+
+
+#define NV_XAL_EP_UFLUSH_TOKEN_MASK                  0x7fffffff
+#define NV_XAL_EP_UFLUSH_STATUS_BUSY                 0x80000000
+#define NV_XAL_EP_MEMOP_MAX_OUTSTANDING              140
+
+static bool
+check_completed_l2_flush_token(struct nvkm_device *device, u32 start_token)
+{
+	u32 v = nvkm_rd32(device, NV_XAL_EP_UFLUSH_L2_FLUSH_DIRTY_COMPLETED);
+	u32 completed_token;
+
+	completed_token = NVVAL(NV_XAL_EP_UFLUSH, L2_FLUSH_DIRTY, COMPLETED_TOKEN, v);
+	if (((start_token - completed_token) & DRF_MASK(NV_XAL_EP_UFLUSH_L2_FLUSH_DIRTY_TOKEN)) >
+	    NV_XAL_EP_MEMOP_MAX_OUTSTANDING)
+		return true;
+
+	/* still processing token */
+	if (NVDEF_TEST(v, NV_XAL_EP_UFLUSH, L2_FLUSH_DIRTY, COMPLETED_STATUS, ==, BUSY))
+		return false;
+
+	return true;
+}
+
+
+static bool
+check_completed_l2_sysmem_invalidate_token(struct nvkm_device *device, u32 start_token)
+{
+	u32 v = nvkm_rd32(device, NV_VIRTUAL_FUNCTION_PRIV_FUNC_L2_SYSMEM_INVALIDATE_COMPLETED);
+	u32 completed_token;
+
+	completed_token = NVVAL(NV_VIRTUAL_FUNCTION_PRIV_FUNC, L2_SYSMEM_INVALIDATE, COMPLETED_TOKEN, v);
+	if (((start_token - completed_token) & DRF_MASK(NV_VIRTUAL_FUNCTION_PRIV_FUNC_L2_SYSMEM_INVALIDATE_TOKEN)) >
+	    NV_XAL_EP_MEMOP_MAX_OUTSTANDING)
+		return true;
+
+	/* still processing token */
+	if (NVDEF_TEST(v, NV_VIRTUAL_FUNCTION_PRIV_FUNC, L2_SYSMEM_INVALIDATE, COMPLETED_STATUS, ==, BUSY))
+		return false;
+
+	return true;
+}
+
+static void
+gh100_ltc_op(struct nvkm_ltc *ltc, int op)
+{
+	struct nvkm_device *device = ltc->subdev.device;
+
+	if (op) {
+		u32 start_token = nvkm_rd32(device, NV_XAL_EP_UFLUSH_L2_FLUSH_DIRTY);
+		start_token = NVVAL(NV_XAL_EP_UFLUSH, L2_FLUSH_DIRTY, TOKEN, start_token);
+
+		nvkm_msec(device, 2000,
+			  if (check_completed_l2_flush_token(device, start_token))
+				  break;
+			);
+
+		start_token = nvkm_rd32(device, NV_VIRTUAL_FUNCTION_PRIV_FUNC_L2_SYSMEM_INVALIDATE);
+		start_token = NVVAL(NV_VIRTUAL_FUNCTION_PRIV_FUNC, L2_SYSMEM_INVALIDATE, TOKEN, start_token);
+
+		nvkm_msec(device, 2000,
+			  if (check_completed_l2_sysmem_invalidate_token(device, start_token))
+				  break;
+			);
+	}
+}
+
+static const struct nvkm_ltc_func
+gh100_ltc = {
+	.op = gh100_ltc_op,
+};
+
+int
+gh100_ltc_new(struct nvkm_device *device, enum nvkm_subdev_type type, int inst,
+	      struct nvkm_ltc **pltc)
+{
+	return r535_ltc_new(&gh100_ltc, device, type, inst, pltc);
+}
