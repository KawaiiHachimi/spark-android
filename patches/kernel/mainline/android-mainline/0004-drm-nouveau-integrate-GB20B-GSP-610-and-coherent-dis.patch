index 0000000000000000000000000000000000000000..9b8df8d647413580e3aaa3d49b04d3e7ccc102ce
--- /dev/null
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/instmem/gb10b.c
@@ -0,0 +1,289 @@
+/*
