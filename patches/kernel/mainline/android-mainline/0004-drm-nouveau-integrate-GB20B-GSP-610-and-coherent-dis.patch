+	.api = &r610_api,
+	.ucodes_fw = true,
+};
+
+const struct nvkm_rm_impl
+r610_rm_gh100 = {
+	.wpr = &r610_wpr_libos3_gh100,
+	.api = &r610_api,
+	.ucodes_fw = true,
+};
+
+const struct nvkm_rm_impl
+r610_rm_gb10x = {
+	.wpr = &r610_wpr_libos3_gb10x,
+	.api = &r610_api,
+	.ucodes_fw = true,
+};
+
+const struct nvkm_rm_impl
+r610_rm_gb20x = {
