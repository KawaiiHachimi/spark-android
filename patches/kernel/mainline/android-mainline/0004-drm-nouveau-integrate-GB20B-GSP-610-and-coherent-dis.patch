+// SPDX-License-Identifier: MIT
+
+#include "priv.h"
+
+#include <nvhw/drf.h>
+#include <nvhw/ref/gb20b/dev_boot.h>
+#include <nvhw/ref/gb20b/dev_sec_pri.h>
+
+#include <nvrm/nvtypes.h>
+
+#include <nvkm/core/mctp.h>
+
+#define SEC2_EMEM_CHANNEL_RM             0x0
+#define SEC2_EMEM_CHANNEL_RM_SIZE        1024
+
+static void *
+gb20b_sec2_dtor(struct nvkm_engine *engine)
+{
+	struct nvkm_sec2 *sec2 = nvkm_sec2(engine);
+	return sec2;
+}
+
+static int
+gb20b_sec2_wait_secure_boot(struct nvkm_sec2 *sec2)
+{
+	struct nvkm_device *device = sec2->engine.subdev.device;
+	unsigned timeout_ms = 4000;
+
+	do {
+		u32 status = NVKM_RD32(device, NV_PMC, SCRATCH_RESET_PLUS_2, VALUE);
+
+		if (status == 0xff)
+			return 0;
+
+		usleep_range(1000, 2000);
+	} while (timeout_ms--);
+
+	return -ETIMEDOUT;
+
+}
+
+static void
+gb20b_sec2_preinit(struct nvkm_engine *engine)
+{
+	struct nvkm_sec2 *sec2 = nvkm_sec2(engine);
+
+	gb20b_sec2_wait_secure_boot(sec2);
+}
+
+static const struct nvkm_engine_func
+gb20b_sec2 = {
+	.dtor = gb20b_sec2_dtor,
+	.preinit = gb20b_sec2_preinit,
+};
+
+
+static u32
+gb20b_sec2_poll(struct nvkm_sec2 *sec2)
+{
+	struct nvkm_device *device = sec2->engine.subdev.device;
+	u32 head, tail;
+
+	head = nvkm_rd32(device, NV_PSEC_MSGQ_HEAD(SEC2_EMEM_CHANNEL_RM));
+	tail = nvkm_rd32(device, NV_PSEC_MSGQ_TAIL(SEC2_EMEM_CHANNEL_RM));
+
+	if (head == tail)
+		return 0;
+
+	return (tail - head) + sizeof(u32); /* TAIL points at last DWORD written. */
+}
+
+static int
+gb20b_sec2_recv(struct nvkm_sec2 *sec2, u8 *packet, u32 max_packet_size)
+{
+	struct nvkm_device *device = sec2->engine.subdev.device;
+	u32 packet_size;
+	int ret;
+
+	packet_size = gb20b_sec2_poll(sec2);
+	if (!packet_size || WARN_ON(packet_size % 4 || packet_size > max_packet_size))
+		return -EINVAL;
+
+	ret = nvkm_falcon_pio_rd(&sec2->falcon, 0, EMEM, 0, packet, 0, packet_size);
+	if (ret)
+		return ret;
+
+	nvkm_wr32(device, NV_PSEC_MSGQ_TAIL(SEC2_EMEM_CHANNEL_RM), 0);
+	nvkm_wr32(device, NV_PSEC_MSGQ_HEAD(SEC2_EMEM_CHANNEL_RM), 0);
+
+	return packet_size;
+}
+
+static int
+gb20b_sec2_wait(struct nvkm_sec2 *sec2)
+{
+	int time = 1000;
+
+	do {
+		if (gb20b_sec2_poll(sec2))
+			return 0;
+
+		usleep_range(1000, 2000);
+	} while(time--);
+
+	return -ETIMEDOUT;
+}
+
+static int
+gb20b_sec2_send(struct nvkm_sec2 *sec2, const u8 *packet, u32 packet_size)
+{
+	struct nvkm_device *device = sec2->engine.subdev.device;
+	int time = 1000, ret;
+
+	if (WARN_ON(packet_size % sizeof(u32)))
+		return -EINVAL;
+
+	/* Ensure any previously sent message has been consumed. */
+	do {
+		u32 head = nvkm_rd32(device, NV_PSEC_QUEUE_HEAD(SEC2_EMEM_CHANNEL_RM));
+		u32 tail = nvkm_rd32(device, NV_PSEC_QUEUE_TAIL(SEC2_EMEM_CHANNEL_RM));
+
+		if (tail == head)
+			break;
+
+		usleep_range(1000, 2000);
+	} while(time--);
+
+	if (time < 0)
+		return -ETIMEDOUT;
+
+	/* Write message to EMEM. */
+	ret = nvkm_falcon_pio_wr(&sec2->falcon, packet, 0, 0, EMEM, 0, packet_size, 0, false);
+	if (ret)
+		return ret;
+
+	/* Update queue pointers - TAIL points at last DWORD written. */
+	nvkm_wr32(device, NV_PSEC_QUEUE_TAIL(SEC2_EMEM_CHANNEL_RM), packet_size - sizeof(u32));
+	nvkm_wr32(device, NV_PSEC_QUEUE_HEAD(SEC2_EMEM_CHANNEL_RM), 0);
+	return 0;
+}
+
+static int
+gb20b_sec2_send_sync(struct nvkm_sec2 *sec2, u8 nvdm_type, const u8 *packet, u32 packet_size)
+{
+	struct nvkm_subdev *subdev = &sec2->engine.subdev;
+	struct {
+		u32 mctp_header;
+		u32 nvdm_header;
+		NVDM_PAYLOAD_COMMAND_RESPONSE response;
+	} reply;
+	int ret;
+
+	ret = gb20b_sec2_send(sec2, packet, packet_size);
+	if (ret)
+		return ret;
+
+	ret = gb20b_sec2_wait(sec2);
+	if (ret)
+		return ret;
+
+	ret = gb20b_sec2_recv(sec2, (u8 *)&reply, sizeof(reply));
+	if (ret < 0)
+		return ret;
+
+	if (NVVAL_TEST(reply.mctp_header, MCTP, HEADER, SOM, !=, 1) ||
+	    NVVAL_TEST(reply.mctp_header, MCTP, HEADER, EOM, !=, 1)) {
+		nvkm_error(subdev, "unexpected MCTP header in reply: 0x%08x\n", reply.mctp_header);
+		return -EIO;
+	}
+
+	if (NVDEF_TEST(reply.nvdm_header, MCTP, MSG_HEADER, TYPE, !=, VENDOR_PCI) ||
+	    NVDEF_TEST(reply.nvdm_header, MCTP, MSG_HEADER, VENDOR_ID, !=, NV) ||
+	    NVVAL_TEST(reply.nvdm_header, MCTP, MSG_HEADER, NVDM_TYPE, !=, NVDM_TYPE_FSP_RESPONSE)) {
+		nvkm_error(subdev, "unexpected NVDM header in reply: 0x%08x\n", reply.nvdm_header);
+		return -EIO;
+	}
+
+	if (reply.response.commandNvdmType != nvdm_type) {
+		nvkm_error(subdev, "expected NVDM type 0x%02x in reply, got 0x%02x\n",
+			   nvdm_type, reply.response.commandNvdmType);
+		return -EIO;
+	}
+
+	if (reply.response.errorCode) {
+		nvkm_error(subdev, "NVDM command 0x%02x failed with error 0x%08x\n",
+			   nvdm_type, reply.response.errorCode);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int
+gb20b_sec2_boot_gsp_fmc(struct nvkm_sec2 *sec2, u64 args_addr, u32 rsvd_size, bool resume,
+			u64 img_addr, const u8 *hash, const u8 *pkey, const u8 *sig)
+{
+	struct {
+		u32 mctp_header;
+		u32 nvdm_header;
+		NVDM_PAYLOAD_COT cot;
+	} msg = {};
+
+	msg.mctp_header = NVVAL(MCTP, HEADER, VERSION, 1) |
+			  NVVAL(MCTP, HEADER, SOM, 1) |
+			  NVVAL(MCTP, HEADER, EOM, 1) |
+			  NVVAL(MCTP, HEADER, SEID, 0) |
+			  NVVAL(MCTP, HEADER, SEQ, 0);
+
+	msg.nvdm_header = NVDEF(MCTP, MSG_HEADER, TYPE, VENDOR_PCI) |
+			  NVDEF(MCTP, MSG_HEADER, VENDOR_ID, NV) |
+			  NVVAL(MCTP, MSG_HEADER, NVDM_TYPE, NVDM_TYPE_COT);
+
+	msg.cot.version = sec2->func->cot.version;
+	msg.cot.size = sizeof(msg.cot);
+	msg.cot.gspFmcSysmemOffset = img_addr;
+
+	msg.cot.frtsVidmemOffset = 0;
+	msg.cot.frtsVidmemSize = 0;
+	msg.cot.frtsSysmemOffset = 0;
+	msg.cot.frtsSysmemSize = 0;
+
+	memcpy(msg.cot.hash384, hash, sec2->func->cot.size_hash);
+	memcpy(msg.cot.publicKey, pkey, sec2->func->cot.size_pkey);
+	memcpy(msg.cot.signature, sig, sec2->func->cot.size_sig);
+
+	msg.cot.gspBootArgsSysmemOffset = args_addr;
+
+	return gb20b_sec2_send_sync(sec2, NVDM_TYPE_COT, (const u8 *)&msg, sizeof(msg));
+}
+
+static const struct nvkm_falcon_func
+gb20b_sec2_flcn = {
+	.disable = gm200_flcn_disable,
+	.enable = gm200_flcn_enable,
+	.reset_pmc = true,
+	.reset_eng = gp102_flcn_reset_eng,
+	.reset_wait_mem_scrubbing = gm200_flcn_reset_wait_mem_scrubbing,
+	.debug = 0x408,
+	.bind_inst = gm200_flcn_bind_inst,
+	.bind_stat = gm200_flcn_bind_stat,
+	.bind_intr = true,
+	.imem_pio = &gm200_flcn_imem_pio,
+	.dmem_pio = &gm200_flcn_dmem_pio,
+	.emem_addr = 0x01000000,
+	.emem_pio = &gp102_flcn_emem_pio,
+	.start = nvkm_falcon_v1_start,
+	.cmdq = { 0xc00, 0xc04, 8 },
+	.msgq = { 0xc80, 0xc84, 8 },
+};
+
+static const struct nvkm_sec2_func
+gb20b_sec2_func = {
+	.flcn = &gb20b_sec2_flcn,
+	.cot = {
+		.version = 2,
+		.size_hash = 48,
+		.size_pkey = 384,
+		.size_sig = 384,
+		.boot_gsp_fmc = gb20b_sec2_boot_gsp_fmc,
+	},
+};
+
+int
+gb20b_sec2_new(struct nvkm_device *device,
+	       enum nvkm_subdev_type type, int inst, struct nvkm_sec2 **psec2)
+{
+	struct nvkm_sec2 *sec2;
+	int ret;
+
+	if (!(sec2 = *psec2 = kzalloc_obj(*sec2)))
+		return -ENOMEM;
+
+	ret = nvkm_engine_ctor(&gb20b_sec2, device, type, inst, true, &sec2->engine);
+	if (ret)
+		return ret;
+
+	sec2->func = &gb20b_sec2_func;
+
+	return nvkm_falcon_ctor(&gb20b_sec2_flcn, &sec2->engine.subdev, sec2->engine.subdev.name,
+				0x840000, &sec2->falcon);
+}
