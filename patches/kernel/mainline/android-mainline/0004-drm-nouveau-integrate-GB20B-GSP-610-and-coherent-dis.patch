+/******************************************************************************
+ * IMP
+ *****************************************************************************/
+
+/* IMP-driven mode admission, following OpenRM's validateMode logic.
+ * Each candidate mode is validated through RM's isModePossible with a
+ * single-head configuration in isolation on every output protocol.
+ *
+ * Multi-head contention is not modelled here and the full
+ * configuration check runs again at atomic_check.
+ */
+enum drm_mode_status
+nv50_imp_mode_valid(struct drm_connector *connector,
+		    const struct drm_display_mode *mode)
+{
+	struct drm_device *dev = connector->dev;
+	struct nv50_disp *disp = nv50_disp(dev);
+	struct nvif_disp_imp_check_v0 imp = {};
+	struct nvif_disp_imp_check_head_v0 *imph = &imp.head[0];
+	struct drm_display_mode adjusted;
+	struct nv50_head_mode m = {};
+	int probe_head, ret;
+
+	/* OpenRM's NO_EXTENDED_GPU_CAPABILITIES_CHECK override skips
+	 * its per-mode IMP unconditionally. nouveau additionally keeps
+	 * the override refused when the reply configures the hardware
+	 * (tiles), so probe stays coherent with the atomic check.
+	 */
+	if (!nouveau_imp_check && !disp->tile.nr_tiles)
+		return MODE_OK;
+
+	/* Firmware without the IMP API. */
+	if (disp->imp_unsupported)
+		return MODE_OK;
+
+	/* The atomic-path IMP check skips interlaced configurations
+	 * (OpenRM validates a field-based viewport there while
+	 * nouveau's is frame-based). Match it here so probe and atomic
+	 * agree: admitted where the reply is advisory, refused where it
+	 * programs tile ownership.
+	 */
+	if (mode->flags & DRM_MODE_FLAG_INTERLACE)
+		return disp->tile.nr_tiles ? MODE_NO_INTERLACE : MODE_OK;
+
+	ret = pm_runtime_get_sync(dev->dev);
+	if (ret < 0 && ret != -EACCES) {
+		pm_runtime_put_autosuspend(dev->dev);
+		goto fail;
+	}
+
+	/* The raster exactly as the head would program it. */
+	adjusted = *mode;
+	nv50_head_mode_from_drm(&adjusted, &m);
+
+	/* Probe against the first head the hardware actually has. */
+	probe_head = disp->disp->head_mask ? ffs(disp->disp->head_mask) - 1 : 0;
+
+	imp.num_heads = 1;
+	imp.tiled = disp->tile.nr_tiles > 0;
+	imph->index = probe_head;
+	/* Probe validates the unscaled viewport: two taps, 1x ratios. */
+	imph->vtaps = 2;
+	/* A non-zero mask would force an exact assignment, zero lets IMP
+	 * compute one and the allocator can drive whatever it picks. The
+	 * other heads are absent from this query so what it computes is
+	 * what a single head could have. Contention with heads that are
+	 * already up is settled at atomic_check like every other
+	 * multi-head cost.
+	 */
+	imph->tile_mask = 0;
+	imph->pclk_khz = m.clock;
+	imph->htotal = m.h.active;
+	imph->vtotal = m.v.active;
+	imph->hblanks = m.h.blanks;
+	imph->hblanke = m.h.blanke;
+	imph->vblanks = m.v.blanks;
+	imph->vblanke = m.v.blanke;
+	imph->in_w = mode->hdisplay;
+	imph->in_h = mode->vdisplay;
+	imph->out_w = mode->hdisplay;
+	imph->out_h = mode->vdisplay;
+
+	/* Probe at the usage floor (a primary that can scan the 4 bpp
+	 * compositor fallback, second window unused). A mode only
+	 * possible below the full bounds is admitted here and the
+	 * modeset path settles what it costs (OpenRM's
+	 * validateMode runs the same downgrade
+	 * (nvValidateImpOneDispDowngrade() from
+	 * nvConstructHwModeTimingsImpCheckEvo())).
+	 */
+	imph->wndw_formats[0] = NVIF_DISP_IMP_FORMAT_RGB_PACKED_1_BPP |
+				NVIF_DISP_IMP_FORMAT_RGB_PACKED_2_BPP |
+				NVIF_DISP_IMP_FORMAT_RGB_PACKED_4_BPP;
+
+	ret = nvif_disp_imp_check(disp->disp, &imp);
+	pm_runtime_mark_last_busy(dev->dev);
+	pm_runtime_put_autosuspend(dev->dev);
+	if (ret == -ENODEV) {
+		disp->imp_unsupported = true;
+		return MODE_OK;
+	}
+	if (ret)
+		goto fail;
+
+	return imp.possible ? MODE_OK : MODE_CLOCK_HIGH;
+
+fail:
+	/* A failing control rejects the mode. */
+	drm_warn_once(dev, "IMP mode check failed (%d), rejecting\n", ret);
+	return MODE_ERROR;
+}
