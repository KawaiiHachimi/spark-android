index 0000000000000000000000000000000000000000..adcba1e3e756ba59982667453316cf0e7fd54e8c
--- /dev/null
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/ltc/gh100.c
@@ -0,0 +1,122 @@
+/*
