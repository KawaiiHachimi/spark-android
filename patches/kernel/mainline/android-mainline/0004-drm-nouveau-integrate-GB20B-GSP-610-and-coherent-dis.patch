+static int
+flcn_fw_boot(struct nvkm_falcon *falcon, u32 boot_addr, u32 *pmbox0, u32 *pmbox1, u32 mbox0_ok, u32 irqsclr)
+{
+	u32 mbox0, mbox1;
+	int ret = 0;
+
+	nvkm_falcon_wr32(falcon, 0x040, pmbox0 ? *pmbox0 : 0xcafebeef);
+	if (pmbox1)
+		nvkm_falcon_wr32(falcon, 0x044, *pmbox1);
+
+	nvkm_falcon_wr32(falcon, 0x104, boot_addr);
+	nvkm_falcon_wr32(falcon, 0x100, 0x00000002);
+
+	if (nvkm_msec(falcon->owner->device, 2000,
+		if (nvkm_falcon_rd32(falcon, 0x100) & 0x00000010)
+			break;
+	) < 0)
+		ret = -ETIMEDOUT;
+
+	mbox0 = nvkm_falcon_rd32(falcon, 0x040);
+	mbox1 = nvkm_falcon_rd32(falcon, 0x044);
+	if (FLCN_ERRON(falcon, ret || mbox0 != mbox0_ok, "mbox %08x %08x", mbox0, mbox1))
+		ret = ret ?: -EIO;
+
+	if (irqsclr)
+		nvkm_falcon_mask(falcon, 0x004, 0xffffffff, irqsclr);
+
+	return ret;
+}
+
+static int
+gsp_core_resume(struct nvkm_gsp *gsp)
+{
+	struct nvkm_subdev *subdev = &gsp->subdev;
+	struct nvkm_device *device = subdev->device;
+	struct nvkm_falcon *falcon = &gsp->falcon;
+	u32 mbox0;
+	int ret = 0;
+
+	nvkm_falcon_wr32(falcon, 0x040, lower_32_bits(gsp->libos.addr));
+	nvkm_falcon_wr32(falcon, 0x044, upper_32_bits(gsp->libos.addr));
+
+	nvkm_falcon_start(&device->sec2->falcon);
+
+	if (nvkm_msec(device, 2000,
+		      if (nvkm_rd32(device, 0x1180f8) & 0x04000000)
+			      break;
+		    ) < 0)
+		return -ETIMEDOUT;
+
+	mbox0 = nvkm_falcon_rd32(&device->sec2->falcon, 0x040);
+	if (WARN_ON(mbox0)) {
+		nvkm_error(&gsp->subdev, "seq core resume sec2: 0x%x\n", mbox0);
+		return -EIO;
+	}
+
+	nvkm_falcon_wr32(falcon, 0x080, gsp->boot.app_version);
+
+	if (WARN_ON(!nvkm_falcon_riscv_active(falcon)))
+		return -EIO;
+	return ret;
+}
+
+static int
+r610_gsp_msg_load_exec_generic_bootloader(void *priv, u32 fn, void *repv, u32 repc)
+{
+	struct nvkm_gsp *gsp = priv;
+	struct nvkm_subdev *subdev = &gsp->subdev;
+	struct nvkm_device *device = subdev->device;
+	struct nvkm_falcon *falcon = &gsp->falcon;
+	GspLoadExecGenericBootloaderParams *params = repv;
+	const struct nvfw_bin_hdr *hdr;
+	const struct nvfw_bl_desc *bld;
+	int ret;
+
+	/* wait for processor suspend */
+	nvkm_msec(device, 2000,
+		  if (nvkm_falcon_rd32(falcon, 0x040) == 0x80000000)
+			  break;
+	);
+	nvkm_falcon_reset(falcon);
+	/* disable ctx req */
+	nvkm_falcon_mask(falcon, 0x624, 0x00000080, 0x00000080);
+	nvkm_falcon_wr32(falcon, 0x10c, 0x00000000);
+
+	u32 save_val = nvkm_falcon_rd32(falcon, 0x600 + (4 * params->dmemDesc.ctx_dma));
+	nvkm_error(subdev, "%s %d\n", __func__, params->dmemDescSize);
+
+	flcn_bl_dmem_desc_v2_dump(subdev, &params->dmemDesc);
+
+	printk(KERN_ERR "%s: %p\n", __func__, gsp->fws.gen_bl);
+	hdr = nvfw_bin_hdr(subdev, gsp->fws.gen_bl->data);
+	bld = nvfw_bl_desc(subdev, gsp->fws.gen_bl->data + hdr->header_offset);
+
+	u32 boot_addr = bld->start_tag << 8;
+	u32 boot_size = bld->code_size;
+
+	const void *code_addr = gsp->fws.gen_bl->data + hdr->data_offset + bld->code_off;
+	printk(KERN_ERR "%s: about to pio\n", __func__);
+	ret = nvkm_falcon_pio_wr(falcon, code_addr, 0, 0,
+				 IMEM, falcon->code.limit - boot_size, boot_size,
+				 bld->start_tag, false);
+	if (ret)
+		return ret;
+
+	u32 fbif = (1 << 2);
+	if (params->addrSpace == 1 && params->cpuCacheAttrib == 0)
+		fbif |= 1;
+	if (params->addrSpace == 1 && params->cpuCacheAttrib == 1)
+		fbif |= 2;
+
+	nvkm_falcon_mask(falcon, 0x600 + params->dmemDesc.ctx_dma * 4, 0x00000007, fbif);
+	printk(KERN_ERR "%s: about to pio 2\n", __func__);
+	ret = nvkm_falcon_pio_wr(falcon, (u8 *)&params->dmemDesc, 0, 0, DMEM, 0, sizeof(params->dmemDesc), 0, 0);
+	if (ret)
+		return ret;
+
+	printk(KERN_ERR "%s: about to boot\n", __func__);
+	u32 mbox0 = 0xfe, mbox1 = 0, mbox0_ok = 0;
+	ret = flcn_fw_boot(falcon, boot_addr, &mbox0, &mbox1, mbox0_ok, 0);
+	if (ret) {
+		printk(KERN_ERR "failed to boot HS %08x %08x\n", mbox0, mbox1);
+
+	}
+
+	nvkm_falcon_wr32(falcon, 0x600 + 4 * params->dmemDesc.ctx_dma, save_val);
+	return gsp_core_resume(gsp);
+}
+
+
+static int
+r610_gsp_msg_load_exec_hs_binary(void *priv, u32 fn, void *repv, u32 repc)
+{
+	struct nvkm_gsp *gsp = priv;
+	struct nvkm_subdev *subdev = &gsp->subdev;
+	struct nvkm_device *device = subdev->device;
+	struct nvkm_falcon *falcon = &gsp->falcon;
+	GspLoadExecHsBinaryParams *params = repv;
+	int ret;
+	u32 mem_off = 0;
+
+	/* wait for processor suspend */
+	nvkm_msec(device, 2000,
+		  if (nvkm_falcon_rd32(&gsp->falcon, 0x040) == 0x80000000)
+			  break;
+	);
+
+	nvkm_falcon_reset(falcon);
+	/* disable ctx req */
+	nvkm_falcon_mask(falcon, 0x624, 0x00000080, 0x00000080);
+	nvkm_falcon_wr32(falcon, 0x10c, 0x00000000);
+
+	/* engine id 16, mem type 2, target 0:1 */
+	nvkm_falcon_mask(falcon, 0x600, 0x00010007, (0 << 16) | (1 << 2) | 0);
+
+	ret = nvkm_falcon_dma_wr(falcon, NULL, params->imemPhysAddr,
+				 params->ucodeImemVA, IMEM,
+				 params->ucodeImemPA, params->ucodeImemSize, true);
+
+	if (params->ucodeDmemVA != 0xffffffff)
+		mem_off = params->ucodeDmemVA;
+
+	ret = nvkm_falcon_dma_wr(falcon, NULL, params->dmemPhysAddr,
+				 mem_off, DMEM,
+				 params->ucodeDmemPA, params->ucodeDmemSize, false);
+
+	nvkm_falcon_wr32(falcon, falcon->addr2 + 0x210, params->hsSigDmemAddr);
+	nvkm_falcon_wr32(falcon, falcon->addr2 + 0x19c, params->engineIdMask);
+	nvkm_falcon_wr32(falcon, falcon->addr2 + 0x198, params->ucodeId);
+	nvkm_falcon_wr32(falcon, falcon->addr2 + 0x180, 0x00000001);
+
+	u32 mbox0 = 0xfe, mbox1 = 0, mbox0_ok = 0;
+	ret = flcn_fw_boot(falcon, params->ucodeImemVA, &mbox0, &mbox1, mbox0_ok, 0);
+	if (ret) {
+		printk(KERN_ERR "failed to boot HS %08x %08x\n", mbox0, mbox1);
+
+	}
+
+	return gsp_core_resume(gsp);
+}
+
+static void
+r610_gsp_add_callbacks(struct nvkm_gsp *gsp)
+{
+	/* no sequencer */
+	r535_gsp_msg_ntfy_add(gsp, NV_VGPU_MSG_EVENT_GSP_LOAD_EXEC_GENERIC_BOOTLOADER,
+			      r610_gsp_msg_load_exec_generic_bootloader, gsp);
+	r535_gsp_msg_ntfy_add(gsp, NV_VGPU_MSG_EVENT_GSP_LOAD_EXEC_HS_BINARY,
+			      r610_gsp_msg_load_exec_hs_binary, gsp);
+}
+
+static void
+r610_gsp_create_pte_array(u64 *ptes, dma_addr_t addr, size_t size)
+{
+	ptes[0] = (u64)addr;
+}
+
+static int
+gsp_fill_libos_entry(struct nvkm_gsp *gsp,
+		     LibosMemoryRegionInitArgument *arg,
+		     size_t size,
+		     struct nvkm_gsp_mem *mem,
+		     const char *name)
+{
+	int ret;
+
+	ret = nvkm_gsp_mem_ctor(gsp, size, mem);
+	if (ret)
+		return ret;
+
+	arg->id8  = r535_gsp_libos_id8(name);
+	arg->pa   = mem->addr;
+	arg->size = mem->size;
+	arg->kind = LIBOS_MEMORY_REGION_CONTIGUOUS;
+	arg->loc  = LIBOS_MEMORY_REGION_LOC_SYSMEM;
+	r610_gsp_create_pte_array(mem->data + sizeof(u64), mem->addr, mem->size);
+	return 0;
+}
+
+static int
+r610_gsp_libos_init(struct nvkm_gsp *gsp)
+{
+	LibosMemoryRegionInitArgument *args;
+	int ret;
+	int idx;
+
+	ret = nvkm_gsp_mem_ctor(gsp, 0x1000, &gsp->notify_op);
+	if (ret)
+		return ret;
+
+	ret = nvkm_gsp_mem_ctor(gsp, 0x1000, &gsp->libos);
+	if (ret)
+		return ret;
+
+	args = gsp->libos.data;
+
+	ret = gsp_fill_libos_entry(gsp, &args[0], 0x10000, &gsp->loginit, "LOGINIT");
+	if (ret)
+		return ret;
+
+	idx = 1;
+	if (!gsp->rm->wpr->is_libos2) {
+		ret = gsp_fill_libos_entry(gsp, &args[idx], 0x10000, &gsp->logintr, "LOGINTR");
+		if (ret)
+			return ret;
+		idx++;
+	}
+
+	ret = gsp_fill_libos_entry(gsp, &args[idx], 0x10000, &gsp->logrm, "LOGRM");
+	if (ret)
+		return ret;
+	idx++;
+
+	if (!gsp->rm->wpr->is_libos2) {
+		ret = gsp_fill_libos_entry(gsp, &args[idx], 0x10000, &gsp->logmnoc, "LOGMNOC");
+		if (ret)
+			return ret;
+		idx++;
+
+		ret = gsp_fill_libos_entry(gsp, &args[idx], 0x10000, &gsp->logdbg, "LOGDBG");
+		if (ret)
+			return ret;
+		idx++;
+
+		ret = gsp_fill_libos_entry(gsp, &args[idx], 0x1000, &gsp->logroot, "LOGROOT");
+		if (ret)
+			return ret;
+		idx++;
+
+		ret = gsp_fill_libos_entry(gsp, &args[idx], 0x1000, &gsp->logrmon, "LOGRMON");
+		if (ret)
+			return ret;
+		idx++;
+
+		ret = gsp_fill_libos_entry(gsp, &args[idx], 0x10000, &gsp->logkrnl, "LOGKRNL");
+		if (ret)
+			return ret;
+		idx++;
+	}
+
+	ret = nvkm_gsp_mem_ctor(gsp, 0x1000, &gsp->state_mon);
+	if (ret)
+		return ret;
+
+	ret = r535_gsp_rmargs_init(gsp, false);
+	if (ret)
+		return ret;
+
+	args[idx].id8  = r535_gsp_libos_id8("RMARGS");
+	args[idx].pa   = gsp->rmargs.addr;
+	args[idx].size = gsp->rmargs.size;
+	args[idx].kind = LIBOS_MEMORY_REGION_CONTIGUOUS;
+	args[idx].loc  = LIBOS_MEMORY_REGION_LOC_SYSMEM;
+
+#ifdef CONFIG_DEBUG_FS
+	r535_gsp_libos_debugfs_init(gsp);
+#endif
+
+	return 0;
+}
+
+static int
+r610_gsp_fill_fmc_boot_args(struct nvkm_gsp *gsp, struct nvkm_gsp_mem *meta, bool alloc)
+{
+	GSP_FMC_BOOT_PARAMS *args = NULL;
+
+	if (alloc) {
+		int ret = nvkm_gsp_mem_ctor(gsp, sizeof(*args), &gsp->fmc.args);
+		if (ret)
+			return ret;
+	}
+
+	args = gsp->fmc.args.data;
+	args->bootGspRmParams.gspRmDescOffset = meta->addr;
+	args->bootGspRmParams.gspRmDescSize = meta->size;
+	args->bootGspRmParams.target = GSP_DMA_TARGET_COHERENT_SYSTEM;
+	args->bootGspRmParams.bIsGspRmBoot = 1;
+
+	args->gspRmParams.target = GSP_DMA_TARGET_NONCOHERENT_SYSTEM;
+	args->gspRmParams.bootArgsOffset = gsp->libos.addr;
+	return 0;
+}
+
+const struct nvkm_rm_api_gsp
+r610_gsp = {
+	.libos_init = r610_gsp_libos_init,
+	.set_rmargs = r610_gsp_set_rmargs,
+	.set_wpr_boost_flags = r570_gsp_set_wpr_boost_flags,
+	.set_sr_boost_flags = r570_gsp_set_sr_boost_flags,
+	.set_system_info = r610_gsp_set_system_info,
+	.get_static_info = r610_gsp_get_static_info,
+	.xlat_mc_engine_idx = r610_gsp_xlat_mc_engine_idx,
+	.drop_post_nocat_record = r570_gsp_drop_post_nocat_record,
+	.sr_data_size = r570_gsp_sr_data_size,
+	.intr_get_table = r610_gsp_intr_get_table,
+	.alloc_vaspace = r610_alloc_vaspace,
+	.os_error_log = r610_gsp_msg_os_error_log,
+	.add_callbacks = r610_gsp_add_callbacks,
+	.queue_initial_msgs_late = r535_gsp_queue_initial_msgs,
+	.fill_fmc_boot_args= r610_gsp_fill_fmc_boot_args,
+};
