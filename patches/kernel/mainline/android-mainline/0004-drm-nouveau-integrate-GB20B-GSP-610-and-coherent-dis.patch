+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+ * THE COPYRIGHT HOLDER(S) OR AUTHOR(S) BE LIABLE FOR ANY CLAIM, DAMAGES OR
+ * OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE,
+ * ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR
+ * OTHER DEALINGS IN THE SOFTWARE.
+ */
+#include "priv.h"
+
+#include <subdev/gsp.h>
+#include <subdev/ltc.h>
+#include <subdev/timer.h>
+
+#define NV_UFLUSH_L2_FLUSH_DIRTY        0x00070010 /* RW-4R */
+#define NV_VIRTUAL_FUNCTION_PRIV_L2_SYSMEM_INVALIDATE                   0x00B80F00 /* RW-4R */
+
+void
+tu102_ltc_op(struct nvkm_ltc *ltc, int op)
+{
+	struct nvkm_device *device = ltc->subdev.device;
+	s64 taken;
+
+	if (op & NVKM_LTC_OP_VIDMEM)
+		return;
+
+	if (op) {
+		nvkm_wr32(device, NV_VIRTUAL_FUNCTION_PRIV_L2_SYSMEM_INVALIDATE, 0x00000001);
+		taken = nvkm_wait_msec(device, 2000, NV_VIRTUAL_FUNCTION_PRIV_L2_SYSMEM_INVALIDATE, 0x00000003, 0x00000000);
+
+		if (taken > 0)
+			nvkm_debug(&ltc->subdev, "LTC invalidate took %lld ns\n", taken);
+
+		nvkm_wr32(device, NV_UFLUSH_L2_FLUSH_DIRTY, 0x00000001);
+		taken = nvkm_wait_msec(device, 2000, NV_UFLUSH_L2_FLUSH_DIRTY, 0x00000003, 0x00000000);
+		if (taken > 0)
+			nvkm_debug(&ltc->subdev, "LTC flush took %lld ns\n", taken);
+	}
+}
+
+static const struct nvkm_ltc_func
+tu102_ltc = {
+	.oneinit = gp100_ltc_oneinit,
+	.init = gp100_ltc_init,
+	.intr = gp100_ltc_intr,
+	.cbc_clear = gm107_ltc_cbc_clear,
+	.cbc_wait = gm107_ltc_cbc_wait,
+	.zbc_color = 16,
+	.zbc_depth = 16,
+	.zbc_clear_color = gm107_ltc_zbc_clear_color,
+	.zbc_clear_depth = gm107_ltc_zbc_clear_depth,
+	.zbc_clear_stencil = gp102_ltc_zbc_clear_stencil,
+	.op = tu102_ltc_op,
+};
+
+static const struct nvkm_ltc_func
+tu102_gsp_ltc = {
+	.op = tu102_ltc_op
+};
+
+int
+tu102_ltc_new(struct nvkm_device *device, enum nvkm_subdev_type type, int inst,
+	      struct nvkm_ltc **pltc)
+{
+	if (nvkm_gsp_rm(device->gsp)) {
+		return r535_ltc_new(&tu102_gsp_ltc, device, type, inst, pltc);
+	}
+
+	return nvkm_ltc_new_(&tu102_ltc, device, type, inst, pltc);
+}
