@@ -30,6 +30,15 @@ struct nv50_head_atom {
 		u16 iH;
 		u16 oW;
 		u16 oH;
+		/* Output scaler configuration (Turing+). Taps assigned
+		 * from the head's scaler capabilities, actual downscale
+		 * factors x0x400 for the usage bounds.
+		 */
+		u8 htaps;
+		u8 vtaps;
+		u16 max_h;
+		u16 max_v;
+		bool upscale_v;
 	} view;
 
 	struct nv50_head_mode {
@@ -54,6 +63,7 @@ struct nv50_head_atom {
 
 	struct {
 		bool visible;
+		bool iova;
 		u32 handle;
 		u64 offset:40;
 		u8 buffer:1;
@@ -82,6 +92,7 @@ struct nv50_head_atom {
 
 	struct {
 		bool visible;
+		bool iova;
 		u32 handle;
 		u64 offset:40;
 		u8  layout:2;
@@ -130,6 +141,33 @@ struct nv50_head_atom {
 		u8 tu:6;
 	} dp;
 
+	/* GB20x tile/phywin ownership. Zero means "identity", which the
+	 * programming hook translates to tile[head]/phywin[window].
+	 */
+	struct {
+		u8 tiles_mask;
+		u8 phywins_mask[2];	/* per owned window (head*2+n) */
+	} mtc;
+
+	/* Format usage bounds committed by the last IMP negotiation
+	 * (NVIF_DISP_IMP_FORMAT_*). Flips are admitted against them.
+	 * prog holds what the windows' usage bounds are currently
+	 * programmed to in terms of the format ceiling and the fetch
