+int
+nouveau_bo_iova_map(struct nouveau_bo *nvbo)
+{
+	struct ttm_buffer_object *bo = &nvbo->bo;
+	struct nouveau_drm *drm = nouveau_bdev(nvbo->bo.bdev);
+	int ret;
+	struct ttm_tt *tt = nvbo->bo.ttm;
+
+	ret = ttm_bo_reserve(bo, false, false, NULL);
+	if (ret)
+		return ret;
+
+	if (nvbo->iova_mapped) {
+		ttm_bo_unreserve(bo);
+		return 0;
+	}
+
+	ret = sg_alloc_table_from_pages(&nvbo->sg_iova,
+					tt->pages,
+					tt->num_pages, 0,
+					nvbo->bo.base.size,
+					GFP_KERNEL);
+	if (ret)
+		goto out;
+	ret = dma_map_sgtable(drm->dev->dev, &nvbo->sg_iova, DMA_BIDIRECTIONAL, 0);
+	if (ret) {
+		sg_free_table(&nvbo->sg_iova);
+		goto out;
+	}
+
+	printk(KERN_ERR "bo iova %llx %llx\n", nvbo->offset, sg_dma_address(nvbo->sg_iova.sgl));
+	nvbo->iova_mapped = true;
+out:
+	ttm_bo_unreserve(&nvbo->bo);
+	return ret;
+}
+
+static void
+nouveau_bo_iova_unmap_locked(struct nouveau_bo *nvbo)
+{
+	struct nouveau_drm *drm = nouveau_bdev(nvbo->bo.bdev);
+
+	if (nvbo->iova_mapped) {
+		printk(KERN_ERR "bo iova unmap %llx %llx\n", nvbo->offset, sg_dma_address(nvbo->sg_iova.sgl));
+		dma_unmap_sgtable(drm->dev->dev, &nvbo->sg_iova, DMA_BIDIRECTIONAL, 0);
+		sg_free_table(&nvbo->sg_iova);
+	}
+	nvbo->iova_mapped = false;
+}
+
+void
+nouveau_bo_iova_unmap(struct nouveau_bo *nvbo)
+{
+	struct ttm_buffer_object *bo = &nvbo->bo;
+	int ret;
+	ret = ttm_bo_reserve(bo, false, false, NULL);
+	if (ret)
+		return;
+	nouveau_bo_iova_unmap_locked(nvbo);
+	ttm_bo_unreserve(&nvbo->bo);
+}
