+		} prog;
+	} imp;
+
 	union nv50_head_atom_mask {
 		struct {
 			bool olut:1;
@@ -143,6 +181,8 @@ struct nv50_head_atom {
 			bool procamp:1;
 			bool crc:1;
 			bool or:1;
+			bool mtc:1;
+			bool imp:1;
 		};
 		u16 mask;
 	} set, clr;
@@ -214,6 +254,7 @@ struct nv50_wndw_atom {
 			u16 size:11;
 			u8  range:2;
 			u8  output_mode:2;
+			u8  iova:1;
 			void (*load)(struct drm_color_lut *, int size,
 				     void __iomem *);
 		} i;
@@ -238,6 +279,7 @@ struct nv50_wndw_atom {
 		u16 w;
 		u16 h;
 
+		bool iova;
 		u32 handle[6];
 		u64 offset[6];
 	} image;
