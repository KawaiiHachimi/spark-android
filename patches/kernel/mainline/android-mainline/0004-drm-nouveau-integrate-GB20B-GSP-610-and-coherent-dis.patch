+ * active region. mode.v.* is a field height while view.oH is a frame
+ * height, so an interlaced raster cannot be described. The caller
+ * programs OpenRM's default fallback rather than leave the last
+ * mode's value.
+ */
+static inline bool
+nv50_head_min_frame_idle(const struct nv50_head_atom *asyh, u16 *leading, u16 *trailing)
+{
+	const u16 active = asyh->mode.v.blanks - asyh->mode.v.blanke;
+	/* The aspect-scaled viewport can exceed the active raster by a
+	 * line. Clamp like the r570 IMP input builder so the programmed
+	 * idle matches what admission validated.
+	 */
+	const u16 idle_h = min_t(u16, asyh->view.oH, active);
+	int overscan, lead;
+
+	if (asyh->mode.interlace)
+		return false;
+
+	overscan = active / 2 - idle_h / 2;
+	lead = asyh->mode.v.blanke + overscan + 1;
