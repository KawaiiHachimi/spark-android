+static void
+r535_ltc_init(struct nvkm_ltc *ltc)
+{
+}
+
+static int
+r535_ltc_oneinit(struct nvkm_ltc *ltc)
+{
+	return 0;
+}
+
+static int
+r535_ltc_vidmem_op(struct nvkm_ltc *ltc, int op)
+{
+	struct nvkm_gsp *gsp = ltc->subdev.device->gsp;
+
+	NV2080_CTRL_INTERNAL_MEMSYS_L2_INVALIDATE_EVICT_PARAMS *ctrl;
+
+	ctrl = nvkm_gsp_rm_ctrl_get(&gsp->internal.device.subdevice,
+				    NV2080_CTRL_CMD_INTERNAL_MEMSYS_L2_INVALIDATE_EVICT,
+				    sizeof(*ctrl));
+	if (WARN_ON(IS_ERR(ctrl)))
+		return PTR_ERR(ctrl);
+
+	if (op == NVKM_LTC_OP_INVALIDATE)
+		ctrl->flags = NV2080_CTRL_INTERNAL_MEMSYS_L2_INVALIDATE_EVICT_FLAGS_ALL;
+	else if (op == NVKM_LTC_OP_EVICT)
+		ctrl->flags = NV2080_CTRL_INTERNAL_MEMSYS_L2_INVALIDATE_EVICT_FLAGS_ALL |
+			NV2080_CTRL_INTERNAL_MEMSYS_L2_INVALIDATE_EVICT_FLAGS_CLEAN;
+
+	WARN_ON(nvkm_gsp_rm_ctrl_wr(&gsp->internal.device.subdevice, ctrl));
+	return 0;
+}
+
+static void
+r535_ltc_op(struct nvkm_ltc *ltc, int op)
+{
+	struct nvkm_bar *bar = ltc->subdev.device->bar;
+	/* NVIDIA does this explicitly not via bar flush */
+	nvkm_bar_hw_flush(bar);
+
+	if (!ltc->subdev.device->fb || !ltc->subdev.device->fb->ram)
+		op &= ~NVKM_LTC_OP_VIDMEM;
+	if (op & NVKM_LTC_OP_VIDMEM) {
+		r535_ltc_vidmem_op(ltc, op & ~NVKM_LTC_OP_VIDMEM);
+	} else {
+		ltc->gsp.sysmem_op(ltc, op);
+	}
+}
+
+int
+r535_ltc_new(const struct nvkm_ltc_func *hw, struct nvkm_device *device,
+	     enum nvkm_subdev_type type, int inst, struct nvkm_ltc **pltc)
+{
+	struct nvkm_ltc_func *rm;
+	int ret;
+
+	if (!(rm = kzalloc_obj(*rm)))
+		return -ENOMEM;
+
+	rm->op = r535_ltc_op;
+	rm->init = r535_ltc_init;
+	rm->oneinit = r535_ltc_oneinit;
+
+	ret = nvkm_ltc_new_(rm, device, type, inst, pltc);
+	if (ret)
+		return ret;
+
+	(*pltc)->gsp.sysmem_op = hw->op;
+
+	return ret;
+}
