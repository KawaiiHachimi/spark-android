+/* GB20x tile allocation. IMP returns how many tiles each head needs but
+ * choosing which tiles is the driver's job. Follow OpenRM's logic here
+ * (EvoAssignHwHeadMultiTileConfigDispOutputCA()): keep what a head already
+ * owns where it still fits, then fill the gaps from the free pool (TYPE_0
+ * requiring heads first), pairing one physical window per tile on each of the
+ * head's windows.
+ *
+ * Unlike OpenRM we deliberately skip the ReclaimTilesIfTypeIsNotRequired()
+ * step. On TYPE_0 scarcity NVKMS strips TYPE_0 tiles from non-scaling heads
+ * but never retries the starved head, accepting a config with fewer tiles
+ * than IMP required. Fail the check with -ENOSPC instead. A reclaim-and-retry
+ * pass can be added.
+ */
+static bool
+nv50_head_needs_type0_tiles(const struct nv50_head_atom *asyh)
+{
+	/* Scaling needs the fully-featured tile variant. HW YUV420 would too, but
+	 * nouveau does not drive it yet (see GetRequiredTileType()).
+	 */
+	return asyh->view.iW != asyh->view.oW || asyh->view.iH != asyh->view.oH;
+}
+
+/* Drop tiles the head can no longer use: more than it needs, the wrong
+ * type for what it now scans out, or not multi-tile capable when it is
+ * about to be combined (same logic as UnassignExtraOrIncompatibleTiles()).
+ */
+static void
+nv50_head_mtc_unassign_extra(struct nv50_disp *disp,
+			     struct nv50_head_atom *asyh, u8 required)
+{
+	const bool type0 = nv50_head_needs_type0_tiles(asyh);
+	unsigned long mask = asyh->mtc.tiles_mask;
+	u8 tiles = 0, kept = 0, w;
+	int tile;
+
+	for_each_set_bit(tile, &mask, 8) {
+		if (kept >= required)
+			break;
+		if (type0 && !(disp->tile.type0_tiles & BIT(tile)))
+			continue;
+		if (required > 1 && !(disp->tile.multi_tiles & BIT(tile)))
+			continue;
+		tiles |= BIT(tile);
+		kept++;
+	}
+
+	asyh->mtc.tiles_mask = tiles;
+
+	for (w = 0; w < 2; w++) {
+		u8 phywins = 0, kept_pw = 0;
+
+		mask = asyh->mtc.phywins_mask[w];
+		for_each_set_bit(tile, &mask, 8) {
+			if (kept_pw >= kept)
+				break;
+			if (required > 1 &&
+			    !(disp->tile.multi_phywins & BIT(tile)))
+				continue;
+			phywins |= BIT(tile);
+			kept_pw++;
+		}
+		asyh->mtc.phywins_mask[w] = phywins;
+	}
+}
+
+/* Take 'count' tiles out of the free pool. Trimmed tiles are spent
+ * before fully-featured ones so a later scaling head still finds a
+ * TYPE_0 tile, but a request that cannot be met any other way is
+ * upgraded rather than failed (same logic as GetFreeTiles()).
+ */
+static u8
+nv50_disp_tiles_get(struct nv50_disp *disp, u8 count, bool type0, bool multi,
+		    u8 *free_tiles)
+{
+	u8 tiles = 0;
+	int pass;
+
+	for (pass = 0; pass < 2 && count; pass++) {
+		const bool want_type0 = type0 || pass == 1;
+		u8 candidates = *free_tiles & ~tiles;
+
+		if (multi)
+			candidates &= disp->tile.multi_tiles;
+		if (want_type0)
+			candidates &= disp->tile.type0_tiles;
+		else
+			candidates &= ~disp->tile.type0_tiles;
+
+		while (count && candidates) {
+			const u8 tile = __ffs(candidates);
+
+			tiles |= BIT(tile);
+			candidates &= ~BIT(tile);
+			count--;
+		}
+
+		if (type0)
+			break;
+	}
+
+	if (count)
+		return 0;
+
+	*free_tiles &= ~tiles;
+	return tiles;
+}
+
+static int
+nv50_head_mtc_assign(struct nv50_disp *disp, struct nv50_head_atom *asyh,
+		     u8 required, u8 *free_tiles, u8 *free_phywins)
+{
+	const bool type0 = nv50_head_needs_type0_tiles(asyh);
+	const bool multi = required > 1;
+	const u8 have = hweight8(asyh->mtc.tiles_mask);
+	u8 w;
+
+	if (have < required) {
+		const u8 tiles = nv50_disp_tiles_get(disp, required - have,
+						     type0, multi, free_tiles);
+
+		if (!tiles)
+			return -ENOSPC;
+		asyh->mtc.tiles_mask |= tiles;
+	}
+
+	/* One physical window per tile on each of the head's windows
+	 * (AssignNewPhywinsIfNeeded()).
+	 */
+	for (w = 0; w < 2; w++) {
+		u8 candidates = *free_phywins;
+
+		if (multi)
+			candidates &= disp->tile.multi_phywins;
+
+		while (hweight8(asyh->mtc.phywins_mask[w]) < required) {
+			u8 phywin;
+
+			if (!candidates)
+				return -ENOSPC;
+
+			phywin = __ffs(candidates);
+			candidates &= ~BIT(phywin);
+			asyh->mtc.phywins_mask[w] |= BIT(phywin);
+			*free_phywins &= ~BIT(phywin);
+		}
+	}
+
+	return 0;
+}
+
+/* Turn the IMP reply's per-head tile counts into ownership. */
+static int
+nv50_disp_atomic_check_tiles(struct drm_device *dev,
+			     struct drm_atomic_commit *state,
+			     const struct nvif_disp_imp_check_v0 *imp,
+			     const u8 *committed_tiles,
+			     const u8 *committed_phywins)
+{
+	struct nv50_disp *disp = nv50_disp(dev);
+	struct drm_crtc_state *old_crtc_state, *new_crtc_state;
+	struct drm_crtc *crtc;
+	const struct nvif_disp_imp_check_head_v0 *by_head[8] = {};
+	u8 free_tiles = BIT(disp->tile.nr_tiles) - 1;
+	u8 free_phywins = BIT(disp->tile.nr_phywins) - 1;
+	int i, pass, ret;
+
+	for (i = 0; i < imp->num_heads; i++) {
+		const struct nvif_disp_imp_check_head_v0 *imph = &imp->head[i];
+
+		if (imph->index >= ARRAY_SIZE(by_head))
+			return -EINVAL;
+		if (imph->required_tiles < 1)
+			return -EINVAL;
+
+		/* IMP may answer with a DSC-enabled tiling solution when one
+		 * is the only way a mode fits, flagged by a non-zero slice
+		 * count. We cannot drive DSC yet and only get these
+		 * solutions by offering a slice mask, so this never fires
+		 * yet but it must not be scanned out if it ever does.
+		 */
+		if (imph->dsc_slices) {
+			drm_dbg_kms(dev, "head-%d: IMP requires DSC, refusing\n",
+				    imph->index);
+			return -EINVAL;
+		}
+
+		by_head[imph->index] = imph;
+	}
+
+	/* Reuse first. Trim each modeset head to the tiles it can keep,
+	 * then take everything an active head owns, before and after the
+	 * trim, out of the free pools: what a head gives up while staying
+	 * up only frees next commit, as it scans through it until its own
+	 * update lands. Every active head has a reply entry (one that
+	 * couldn't be described aborts the check before we get here), so
+	 * nothing here holds tiles the allocator cannot see. Heads going
+	 * inactive release theirs in this commit's disable update.
+	 */
+	for_each_oldnew_crtc_in_state(state, crtc, old_crtc_state, new_crtc_state, i) {
+		const int head_idx = nv50_head(crtc)->base.index;
+		struct nv50_head_atom *asyh = nv50_head_atom(new_crtc_state);
+		const struct nv50_head_atom *armh = nv50_head_atom(old_crtc_state);
+
+		if (!new_crtc_state->active)
+			continue;
+
+		if (by_head[head_idx] &&
+		    drm_atomic_crtc_needs_modeset(new_crtc_state))
+			nv50_head_mtc_unassign_extra(disp, asyh,
+						     by_head[head_idx]->required_tiles);
+
+		free_tiles &= ~(armh->mtc.tiles_mask | asyh->mtc.tiles_mask);
+		free_phywins &= ~(armh->mtc.phywins_mask[0] |
+				  armh->mtc.phywins_mask[1] |
+				  asyh->mtc.phywins_mask[0] |
+				  asyh->mtc.phywins_mask[1]);
+	}
+
+	/* Then fill the gaps, scaling heads first so the TYPE_0 tiles
+	 * they need are not spent on heads that don't need them
+	 * (same logic as AssignNewTilesToHeadsIfNeeded()).
+	 */
+	for (pass = 0; pass < 2; pass++) {
+		for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
+			const int head_idx = nv50_head(crtc)->base.index;
+			struct nv50_head_atom *asyh = nv50_head_atom(new_crtc_state);
+
+			if (!new_crtc_state->active || !by_head[head_idx] ||
+			    !drm_atomic_crtc_needs_modeset(new_crtc_state) ||
+			    nv50_head_needs_type0_tiles(asyh) != (pass == 0))
+				continue;
+
+			ret = nv50_head_mtc_assign(disp, asyh,
+						   by_head[head_idx]->required_tiles,
+						   &free_tiles, &free_phywins);
+			if (ret) {
+				drm_dbg_kms(dev,
+					    "head-%d: no free tiles for a %d-tile assignment\n",
+					    head_idx,
+					    by_head[head_idx]->required_tiles);
+				return ret;
+			}
+		}
+	}
+
+	/* The hardware cannot move tile or phywin ownership within one
+	 * update. Taking what another head still owns, which the pools
+	 * above only allow from a head going down, needs that head's
+	 * release in the early disable update before the attach, the way
+	 * OpenRM shuts an incompatible head down first
+	 * (IsCurrentMultiTileConfigOneApiHeadIncompatible()).
+	 */
+	for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
+		struct nv50_head_atom *asyh = nv50_head_atom(new_crtc_state);
+		const int head_idx = nv50_head(crtc)->base.index;
+		u8 phywins;
+		int other;
+
+		if (!drm_atomic_crtc_needs_modeset(new_crtc_state))
+			continue;
+
+		phywins = asyh->mtc.phywins_mask[0] | asyh->mtc.phywins_mask[1];
+
+		for (other = 0; other < 8; other++) {
+			if (other == head_idx)
+				continue;
+			if ((committed_tiles[other] & asyh->mtc.tiles_mask) ||
+			    (committed_phywins[other] & phywins))
+				nv50_atom(state)->flush_disable = true;
+		}
+	}
+
+	return 0;
+}
+
+/* Format class of a framebuffer for the IMP window usage bound. */
+static u8
+nv50_imp_format_class(const struct drm_framebuffer *fb)
+{
+	switch (fb->format->format) {
+	case DRM_FORMAT_YUYV:
+	case DRM_FORMAT_UYVY:
+		return NVIF_DISP_IMP_FORMAT_YUV_PACKED_422;
+	default:
+		break;
+	}
+
+	switch (fb->format->cpp[0]) {
+	case 1: return NVIF_DISP_IMP_FORMAT_RGB_PACKED_1_BPP;
+	case 2: return NVIF_DISP_IMP_FORMAT_RGB_PACKED_2_BPP;
+	case 4: return NVIF_DISP_IMP_FORMAT_RGB_PACKED_4_BPP;
+	default:
+		break;
+	}
+	return NVIF_DISP_IMP_FORMAT_RGB_PACKED_8_BPP;
+}
+
+/* Formats at or below a class's usage, the bound the hardware is
+ * programmed with and the floor the ladder must not go below.
+ * (nvEvoGetFormatsWithEqualOrLowerUsageBound()).
+ */
+static u8
+nv50_imp_ceiling(u8 class)
+{
+	if (class & NVIF_DISP_IMP_FORMAT_YUV_PACKED_422)
+		return class;
+	return (class << 1) - 1;
+}
+
+/* Get the viewport bounded fetch width. Identical to OpenRM's
+ * nvGetMaxPixelsFetchedPerLine() at a 1x window scale factor.
+ */
+static u16
+nv50_imp_fetch_width(const struct nv50_head_atom *asyh)
+{
+	return ((((u32)asyh->view.iW + 14) * 0x400 + 1023) >> 10) + 8;
+}
+
+/* Committed bound, everything until the first negotiation. */
+static u8
+nv50_imp_committed(const struct nv50_head_atom *asyh, int w)
+{
+	return asyh->imp.valid ? asyh->imp.wndw_formats[w] :
+				 NVIF_DISP_IMP_FORMAT_ALL;
+}
+
+/* The usage-bound downgrade ladder, following OpenRM's order
+ * (DownGradeMetaModeUsageBounds()): packed-422 before FP16, window 1
+ * before window 0, then window 1's RGB formats until it is left out.
+ * Window 0 stops at 4 bpp as a primary that cannot scan the compositor
+ * fallback is useless to DRM userspace. The VTAPS/HTAPS rungs sit
+ * between the format rungs (DowngradeViewPortVTaps5()/HTaps5()),
+ * falling back from 5 to 2 taps when the line store and ratio allow.
+ */
+#define NV50_IMP_RUNG_VTAPS 0xfe
+#define NV50_IMP_RUNG_HTAPS 0xff
+
+static const struct nv50_imp_downgrade {
+	u8 wndw;
+	u8 clr;
+} nv50_imp_ladder[] = {
+	{ 1, NVIF_DISP_IMP_FORMAT_YUV_PACKED_422 },
+	{ 0, NVIF_DISP_IMP_FORMAT_YUV_PACKED_422 },
+	{ 1, NVIF_DISP_IMP_FORMAT_RGB_PACKED_8_BPP },
+	{ 0, NVIF_DISP_IMP_FORMAT_RGB_PACKED_8_BPP },
+	{ NV50_IMP_RUNG_VTAPS, 0 },
+	{ NV50_IMP_RUNG_HTAPS, 0 },
+	{ 1, NVIF_DISP_IMP_FORMAT_RGB_PACKED_4_BPP },
+	{ 1, NVIF_DISP_IMP_FORMAT_RGB_PACKED_2_BPP },
+	{ 1, NVIF_DISP_IMP_FORMAT_RGB_PACKED_1_BPP },
+};
+
+/* Validate the proposed configuration through RM's IMP (mirrors OpenRM's
+ * nvValidateImpOneDispDowngrade()): describe every active head, walk the
+ * downgrade ladder above for modeset heads, commit the admitted bounds, and
+ * validate flips against them. r535 (-ENODEV) gets imp_unsupported, a failing
+ * control rejects the configuration.
+ * nouveau.imp_check=0 skips the check except where the reply configures the
+ * hardware (GB20x+ tiling).
+ */
+static int
+nv50_disp_atomic_check_imp(struct drm_device *dev, struct drm_atomic_commit *state)
+{
+	struct nv50_disp *disp = nv50_disp(dev);
+	const bool static_wndw_map = disp->core->func->head->static_wndw_map != NULL;
+	struct nvif_disp_imp_check_v0 imp = {};
+	struct nv50_head_atom *asyh_of[8] = {};
+	u8 committed_tiles[8] = {}, committed_phywins[8] = {};
+	u8 demand[8][2] = {}, bounds[8][2] = {};
+	u8 prog_seen[8] = {}, prog_class[8][2] = {};
+	u8 modeset_heads = 0;
+	struct drm_plane *plane;
+	struct drm_plane_state *new_plane_state;
+	struct drm_crtc_state *old_crtc_state, *new_crtc_state;
+	struct drm_crtc *crtc;
+	bool any_modeset = false, interlaced = false;
+	unsigned int rung = 0;
+	int ret, i, w;
+
+	for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
+		if (drm_atomic_crtc_needs_modeset(new_crtc_state))
+			any_modeset = true;
+	}
+
+	/* Per-window format demand of the planes in this commit. Planes
+	 * left untouched already fit the bounds they were admitted
+	 * under. This runs before the admission escapes below and the
+	 * demanded bounds are the truth of what scans out whether or
+	 * not admission is available.
+	 */
+	for_each_new_plane_in_state(state, plane, new_plane_state, i) {
+		struct nv50_wndw *wndw;
+		u8 cls;
+
+		if (plane->type == DRM_PLANE_TYPE_CURSOR)
+			continue;
+
+		wndw = nv50_wndw(plane);
+		/* The buckets index by head through the fixed window
+		 * mapping. Hardware without it pairs base and overlay
+		 * differently, and would fold two windows of one head
+		 * into the same bucket.
+		 */
+		if (!static_wndw_map || wndw->id / 2 >= ARRAY_SIZE(demand))
+			continue;
+
+		prog_seen[wndw->id / 2] |= BIT(wndw->id & 1);
+		/* asyw->visible is what nouveau actually programs and the
+		 * window is bound to an active head. The helper computed
+		 * plane_state->visible reads false for a window that is
+		 * positioned entirely off-screen but still enabled, which
+		 * would park the bounds of a window that is scanning out.
+		 */
+		if (!nv50_wndw_atom(new_plane_state)->visible ||
+		    !new_plane_state->fb)
+			continue;
+
+		cls = nv50_imp_format_class(new_plane_state->fb);
+		prog_class[wndw->id / 2][wndw->id & 1] = cls;
+		demand[wndw->id / 2][wndw->id & 1] |= cls;
+	}
+
+	/* Flips beyond a committed bound fail outright,
+	 * heads that never negotiated (interlace, imp_check=0,
+	 * firmware without the API) keep the pre-IMP permissive
+	 * behavior through the full default bound.
+	 */
+	for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
+		struct nv50_head_atom *asyh = nv50_head_atom(new_crtc_state);
+		const int head_idx = nv50_head(crtc)->base.index;
+
+		if (drm_atomic_crtc_needs_modeset(new_crtc_state))
+			continue;
+
+		for (w = 0; w < 2; w++) {
+			if (demand[head_idx][w] & ~nv50_imp_committed(asyh, w)) {
+				drm_dbg_kms(dev,
+					    "head-%d wndw-%d: format beyond the committed IMP bound\n",
+					    head_idx, w);
+				return -EINVAL;
+			}
+		}
+	}
+
+	/* Track the programmed per-window usage similar to OpenRM's
+	 * AssignUsageBounds(). The usage is raised and lowered with the planes
+	 * in the same interlocked update.
+	 */
+	for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
+		struct nv50_head_atom *asyh = nv50_head_atom(new_crtc_state);
+		const int head_idx = nv50_head(crtc)->base.index;
+
+		if (!disp->core->func->wndw.usage_bounds)
+			break;
+
+		for (w = 0; w < 2; w++) {
+			u8 formats = asyh->imp.prog.formats[w];
+			u16 fetch;
+
+			if (!new_crtc_state->active)
+				formats = 0;
+			else if (prog_seen[head_idx] & BIT(w))
+				formats = prog_class[head_idx][w] ?
+					nv50_imp_ceiling(prog_class[head_idx][w]) : 0;
+			else if (drm_atomic_crtc_needs_modeset(new_crtc_state))
+				/* A modeset pulls in every plane on the head
+				 * so an unseen window is unused.
+				 */
+				formats = 0;
+			fetch = formats ? nv50_imp_fetch_width(asyh) : 0;
+
+			if (formats == asyh->imp.prog.formats[w] &&
+			    fetch == asyh->imp.prog.fetch[w])
+				continue;
+
+			asyh->imp.prog.formats[w] = formats;
+			asyh->imp.prog.fetch[w] = fetch;
+			asyh->set.imp = true;
+			/* Usage bounds are core channel methods so serialize
+			 * the commit like every other core touching path.
+			 */
+			nv50_atom(state)->lock_core = true;
+		}
+
+		/* Watermarks are switched off while windowed content
+		 * scans out without a fullscreen surface on Turing (see
+		 * corec57d_mclk_war()).
+		 */
+		if (disp->disp->glitchy_mclk_switch && disp->core->func->mclk_war) {
+			bool war = new_crtc_state->active &&
+				   !asyh->imp.prog.formats[0] &&
+				   (asyh->curs.visible || asyh->imp.prog.formats[1]);
+
+			if (war != asyh->imp.prog.mclk_war) {
+				asyh->imp.prog.mclk_war = war;
+				asyh->set.imp = true;
+				nv50_atom(state)->lock_core = true;
+			}
+		}
+	}
+
+	/* Only modesets renegotiate and flips within bounds don't need a query. */
+	if (!any_modeset)
+		return 0;
+
+	if (!nouveau_imp_check && !disp->tile.nr_tiles)
+		return 0;
+
+	/* Firmware without the IMP API. */
+	if (disp->imp_unsupported)
+		return 0;
+
+	drm_for_each_crtc(crtc, dev) {
+		new_crtc_state = drm_atomic_get_crtc_state(state, crtc);
+		if (IS_ERR(new_crtc_state))
+			return PTR_ERR(new_crtc_state);
+	}
+
+	/* Ownership as currently committed, for the detach-before-attach
+	 * checks once an assignment comes back.
+	 */
+	for_each_oldnew_crtc_in_state(state, crtc, old_crtc_state, new_crtc_state, i) {
+		const struct nv50_head_atom *armh = nv50_head_atom(old_crtc_state);
+		const int head_idx = nv50_head(crtc)->base.index;
+
+		committed_tiles[head_idx] = armh->mtc.tiles_mask;
+		committed_phywins[head_idx] = armh->mtc.phywins_mask[0] |
+					      armh->mtc.phywins_mask[1];
+	}
+
+	/* OpenRM rejects interlaced timings outright in its mode validation
+	 * (see ValidateModeTimings()). nouveau on the other hand keeps
+	 * admitting them (pre-existing behavior we don't want to regress, DP
+	 * only) and skips IMP because its frame-based viewport breaks the
+	 * field-based frame-idle math. Modeset heads lose their committed bounds
+	 * and nothing is negotiated for the new configuration.
+	 */
+	for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
+		if (new_crtc_state->active &&
+		    nv50_head_atom(new_crtc_state)->mode.interlace)
+			interlaced = true;
+	}
+
+	if (interlaced) {
+		/* With tiles the reply programs hardware and skipping would
+		 * leave the per-head identity fallback free to seize tiles
+		 * another head owns, so refuse, like the undescribable case.
+		 */
+		if (disp->tile.nr_tiles)
+			return -EINVAL;
+		for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
+			if (drm_atomic_crtc_needs_modeset(new_crtc_state))
+				nv50_head_atom(new_crtc_state)->imp.valid = false;
+		}
+		return 0;
+	}
+
+	for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
+		struct nvif_disp_imp_check_head_v0 *imph;
+		struct nv50_head_atom *asyh;
+		const int head_idx = nv50_head(crtc)->base.index;
+		const bool modeset = drm_atomic_crtc_needs_modeset(new_crtc_state);
+
+		if (!new_crtc_state->active) {
+			/* Bounds describe a configuration that is going
+			 * away. The interlace escape above drops them for
+			 * the same reason.
+			 */
+			nv50_head_atom(new_crtc_state)->imp.valid = false;
+			continue;
+		}
+
+		asyh = nv50_head_atom(new_crtc_state);
+		asyh_of[head_idx] = asyh;
+		if (modeset)
+			modeset_heads |= BIT(head_idx);
+
+		/* Every active head is described, inherited ones from their armed
+		 * raster (nv50_head_armed_read()). One that cannot be described
+		 * would drop a live consumer from the query and over-admit
+		 * the rest.
+		 */
+		if (!asyh->mode.clock) {
+			drm_warn_once(dev, "head-%d active but undescribable\n", head_idx);
+
+			/* With tiles the reply programs hardware, so refuse.
+			 * Otherwise admission is advisory and the query is
+			 * skipped (refusing here would hang every modeset as
+			 * imp_unsupported is never set).
+			 */
+			if (disp->tile.nr_tiles)
+				return -EINVAL;
+			return 0;
+		}
+
+		/* Modeset heads start the ladder at the full bound, the
+		 * others hold their committed bound.
+		 */
+		for (w = 0; w < 2; w++) {
+			if (modeset)
+				bounds[head_idx][w] = NVIF_DISP_IMP_FORMAT_ALL;
+			else
+				bounds[head_idx][w] = nv50_imp_committed(asyh, w);
+		}
+
+		imph = &imp.head[imp.num_heads++];
+		imph->index = head_idx;
+		imph->vtaps = asyh->view.vtaps;
+		/* A non-zero mask forces an exact assignment, zero lets IMP
+		 * compute one. Heads being modeset leave the choice to IMP
+		 * and the allocator programs what comes back. The others
+		 * hold the tiles they already own (an empty ownership mask
+		 * is the hardware's identity mapping).
+		 */
+		if (disp->tile.nr_tiles && !modeset)
+			imph->tile_mask = asyh->mtc.tiles_mask ?: BIT(head_idx);
+		imph->pclk_khz = asyh->mode.clock;
+		imph->htotal = asyh->mode.h.active;
+		imph->vtotal = asyh->mode.v.active;
+		imph->hblanks = asyh->mode.h.blanks;
+		imph->hblanke = asyh->mode.h.blanke;
+		imph->vblanks = asyh->mode.v.blanks;
+		imph->vblanke = asyh->mode.v.blanke;
+		imph->in_w = asyh->view.iW;
+		imph->in_h = asyh->view.iH;
+		imph->out_w = asyh->view.oW;
+		imph->out_h = asyh->view.oH;
+	}
+
+	if (!imp.num_heads)
+		return 0;
+
+	imp.tiled = disp->tile.nr_tiles > 0;
+
+	/* Like the probe path: modesets can run outside an ioctl (client
+	 * restore), where nothing else holds a runtime-PM reference for
+	 * the RPC.
+	 */
+	ret = pm_runtime_get_sync(dev->dev);
+	if (ret < 0 && ret != -EACCES) {
+		pm_runtime_put_autosuspend(dev->dev);
+		drm_warn_once(dev, "IMP check unavailable (%d), rejecting\n", ret);
+		return -EINVAL;
+	}
+
+	for (;;) {
+		bool changed = false;
+
+		for (i = 0; i < imp.num_heads; i++) {
+			struct nvif_disp_imp_check_head_v0 *imph = &imp.head[i];
+
+			imph->vtaps = asyh_of[imph->index]->view.vtaps;
+			for (w = 0; w < 2; w++)
+				imph->wndw_formats[w] = bounds[imph->index][w];
+		}
+
+		ret = nvif_disp_imp_check(disp->disp, &imp);
+		if (ret || imp.possible)
+			break;
+
+		/* Walk the downgrade ladder across every modeset head,
+		 * A bit this commit's own planes demand is never removed.
+		 */
+		while (!changed && rung < ARRAY_SIZE(nv50_imp_ladder)) {
+			const struct nv50_imp_downgrade *dg = &nv50_imp_ladder[rung++];
+			unsigned long mheads = modeset_heads;
+			int h;
+
+			for_each_set_bit(h, &mheads, 8) {
+				struct nv50_head_atom *asyh = asyh_of[h];
+				const struct nv50_scaler_caps *scaler =
+					&disp->scaler[h];
+
+				if (dg->wndw == NV50_IMP_RUNG_VTAPS) {
+					if (asyh->view.vtaps != 5 ||
+					    min(asyh->view.iW, asyh->view.oW) >
+						scaler->taps2.max_pixels ||
+					    asyh->view.max_v > scaler->taps2.max_v)
+						continue;
+					asyh->view.vtaps = 2;
+					asyh->set.view = true;
+				} else if (dg->wndw == NV50_IMP_RUNG_HTAPS) {
+					if (asyh->view.htaps != 5 ||
+					    asyh->view.max_h > scaler->taps2.max_h)
+						continue;
+					asyh->view.htaps = 2;
+					asyh->set.view = true;
+				} else {
+					if (!(bounds[h][dg->wndw] & dg->clr) ||
+					    (demand[h][dg->wndw] &&
+					     (nv50_imp_ceiling(demand[h][dg->wndw]) & dg->clr)))
+						continue;
+					bounds[h][dg->wndw] &= ~dg->clr;
+				}
+				nv50_atom(state)->lock_core = true;
+				changed = true;
+			}
+		}
+
+		if (!changed)
+			break;
+	}
+	pm_runtime_mark_last_busy(dev->dev);
+	pm_runtime_put_autosuspend(dev->dev);
+
+	if (ret == -ENODEV) {
+		disp->imp_unsupported = true;
+		return 0;
+	}
+	if (ret) {
+		drm_warn_once(dev, "IMP check failed (%d), rejecting\n", ret);
+		return -EINVAL;
+	}
+	if (!imp.possible) {
+		drm_dbg_kms(dev, "IMP rejected the configuration\n");
+		return -EINVAL;
+	}
+
+	/* Commit the admitted bounds. Flips are validated against them
+	 * from here on.
+	 */
+	for (i = 0; i < imp.num_heads; i++) {
+		const int h = imp.head[i].index;
+		struct nv50_head_atom *asyh = asyh_of[h];
+
+		if (!asyh || !(modeset_heads & BIT(h)))
+			continue;
+
+		asyh->imp.wndw_formats[0] = bounds[h][0];
+		asyh->imp.wndw_formats[1] = bounds[h][1];
+		asyh->imp.valid = true;
+	}
+
+	if (!disp->tile.nr_tiles)
+		return 0;
+
+	return nv50_disp_atomic_check_tiles(dev, state, &imp, committed_tiles,
+					    committed_phywins);
+}
