+ *
+ */
+#include "gf100.h"
+
+#include <nvhw/drf.h>
+#include <subdev/gsp.h>
+#include <subdev/timer.h>
+
+#define NV_XAL_EP_MEMOP_TOKEN_SIZE               31
+#define NV_XAL_EP_MEMOP_TOKEN_MAX_ISSUED         4
+#define NV_XAL_EP_MEMOP_MAX_OUTSTANDING          140
+
+#define NV_XAL_EP_UFLUSH_FB_FLUSH                                              0x0010f800 /* R--4R */
+#define NV_XAL_EP_UFLUSH_FB_FLUSH_TOKEN                                              30:0 /* R-IUF */
+#define NV_XAL_EP_UFLUSH_FB_FLUSH_TOKEN_INIT                                   0x00000000 /* R-I-V */
+#define NV_XAL_EP_UFLUSH_FB_FLUSH_COMPLETED                                    0x0010f804 /* R--4R */
+#define NV_XAL_EP_UFLUSH_FB_FLUSH_COMPLETED_TOKEN                                    30:0 /* R-IUF */
+#define NV_XAL_EP_UFLUSH_FB_FLUSH_COMPLETED_TOKEN_INIT                         0x00000000 /* R-I-V */
+#define NV_XAL_EP_UFLUSH_FB_FLUSH_COMPLETED_STATUS                                  31:31 /* R-IUF */
+#define NV_XAL_EP_UFLUSH_FB_FLUSH_COMPLETED_STATUS_IDLE                               0x0 /* R-I-V */
+#define NV_XAL_EP_UFLUSH_FB_FLUSH_COMPLETED_STATUS_BUSY                               0x1 /* R---V */
+
+static bool
+check_completed_token(struct nvkm_device *device, u32 start_token)
+{
+	u32 v = nvkm_rd32(device, NV_XAL_EP_UFLUSH_FB_FLUSH_COMPLETED);
+	u32 completed_token;
+
+	completed_token = NVVAL(NV_XAL_EP_UFLUSH, FB_FLUSH, COMPLETED_TOKEN, v);
+
+	/* token advanced past ours — our flush is done regardless of BUSY */
+	if (((start_token - completed_token) &
+	     DRF_MASK(NV_XAL_EP_UFLUSH_FB_FLUSH_TOKEN)) >
+	    NV_XAL_EP_MEMOP_MAX_OUTSTANDING)
+		return true;
+
+	if (NVDEF_TEST(v, NV_XAL_EP_UFLUSH, FB_FLUSH, COMPLETED_STATUS, ==, BUSY))
+		return false;
+
+	return true;
+}
+
+void
+gh100_bar_flush(struct nvkm_bar *bar)
+{
+	struct nvkm_device *device = bar->subdev.device;
+
+	u32 start_token = nvkm_rd32(device, NV_XAL_EP_UFLUSH_FB_FLUSH);
+	start_token = NVVAL(NV_XAL_EP_UFLUSH, FB_FLUSH, TOKEN, start_token);
+
+	nvkm_msec(device, 2000,
+		  if (check_completed_token(device, start_token))
+			  break;
+		);
+}
+
+static const struct nvkm_bar_func
+gh100_bar = {
+	.dtor = gf100_bar_dtor,
+	.oneinit = gf100_bar_oneinit,
+	.bar1.vmm = gf100_bar_bar1_vmm,
+	.bar2.vmm = gf100_bar_bar2_vmm,
+	.flush = gh100_bar_flush,
+};
+
+int
+gh100_bar_new(struct nvkm_device *device, enum nvkm_subdev_type type, int inst,
+	    struct nvkm_bar **pbar)
+{
+	return r535_bar_new_(&gh100_bar, device, type, inst, false, pbar);
+}
