+void
+nvkmd_nvgpu_sync_finish(struct vk_device *device,
+                      struct vk_sync *sync)
+{
+}
+
+static VkResult
+nvkmd_nvgpu_sync_signal(struct vk_device *device,
+                      struct vk_sync *sync,
+                      uint64_t value)
+{
+   struct nvkmd_nvgpu_sync *sobj = vk_sync_as_nvgpu_sync(sync);
+   struct nvk_device *nvk_dev = container_of(device, struct nvk_device, vk);
+   struct nvkmd_nvgpu_dev *dev = nvkmd_nvgpu_dev(nvk_dev->nvkmd);
+   struct nvkmd_nvgpu_pdev *pdev = nvkmd_nvgpu_pdev(dev->base.pdev);
+
+   if (!sobj->initialized) {
+      return VK_SUCCESS;
+   }
+
+   uint64_t cur_value;
+   nvkmd_nvgpu_sync_get_value(device, sync, &cur_value);
+   assert(cur_value + 1 == value);
+
+   struct drm_tegra_syncpt_incr incr_args = {
+      .id = sobj->syncpoint_id,
+   };
+   if (ioctl(pdev->render_fd, DRM_IOCTL_TEGRA_SYNCPT_INCR, &incr_args) == -1) {
+      printf("failed DRM_IOCTL_TEGRA_SYNCPT_INCR: %d\n", errno);
+      return VK_ERROR_UNKNOWN;
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_nvgpu_sync_get_value(struct vk_device *device,
+                         struct vk_sync *sync,
+                         uint64_t *value)
+{
+   struct nvkmd_nvgpu_sync *sobj = vk_sync_as_nvgpu_sync(sync);
+   struct nvk_device *nvk_dev = container_of(device, struct nvk_device, vk);
+   struct nvkmd_nvgpu_dev *dev = nvkmd_nvgpu_dev(nvk_dev->nvkmd);
+   struct nvkmd_nvgpu_pdev *pdev = nvkmd_nvgpu_pdev(dev->base.pdev);
+
+   if (!sobj->initialized) {
+      *value = 0;
+      return VK_SUCCESS; // is this correct?
+   }
+
+   struct drm_tegra_syncpt_read read_args = {
+      .id = sobj->syncpoint_id,
+   };
+   if (ioctl(pdev->render_fd, DRM_IOCTL_TEGRA_SYNCPT_READ, &read_args) == -1) {
+      printf("failed DRM_IOCTL_TEGRA_SYNCPT_READ: %d\n", errno);
+      return VK_ERROR_UNKNOWN;
+   }
+
+   *value = read_args.value + sobj->local_offset;
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_nvgpu_sync_reset(struct vk_device *device,
+                     struct vk_sync *sync)
+{
+   struct nvkmd_nvgpu_sync *sobj = vk_sync_as_nvgpu_sync(sync);
+
+   sobj->initialized = false;
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_nvgpu_sync_wait_many(struct vk_device *device,
+                         uint32_t wait_count,
+                         const struct vk_sync_wait *waits,
+                         enum vk_sync_wait_flags wait_flags,
+                         uint64_t abs_timeout_ns)
+{
+   struct nvk_device *nvk_dev = container_of(device, struct nvk_device, vk);
+   struct nvkmd_nvgpu_dev *dev = nvkmd_nvgpu_dev(nvk_dev->nvkmd);
+   struct nvkmd_nvgpu_pdev *pdev = nvkmd_nvgpu_pdev(dev->base.pdev);
+
+   // TODO: improve timeout case?
+
+   for (int i = 0; i < wait_count; ++i) {
+      struct nvkmd_nvgpu_sync *sobj = vk_sync_as_nvgpu_sync(waits[i].sync);
+
+      if (!sobj->initialized) {
+         continue; // no work is pending on this syncpoint. XXX this is not actually correct; things can trigger sync other than GPU work!
+      }
+
+      // if (sobj->base.flags & VK_SYNC_IS_TIMELINE && waits[i].wait_value <= sobj->local_offset) {
+      //    continue; // already finished??
+      // }
+
+      uint64_t cur_val;
+      nvkmd_nvgpu_sync_get_value(device, waits[i].sync, &cur_val);
+
+      // printf("(vk=%p nv=%d) currently am %lu, waiting until %lu (off=%ld)\n", waits[i].sync, sobj->syncpoint_id, cur_val - sobj->local_offset, waits[i].wait_value - sobj->local_offset, sobj->local_offset);
+
+      if (cur_val >= waits[i].wait_value) {
+         continue; // already finished??
+      }
+
+      struct drm_tegra_syncpoint_wait wait_arg = {
+         .timeout_ns = abs_timeout_ns,
+         .id = sobj->syncpoint_id,
+         .threshold = waits[i].wait_value - sobj->local_offset,
+      };
+      if (nvgpu_ioctl(pdev->render_fd, DRM_IOCTL_TEGRA_SYNCPOINT_WAIT, &wait_arg) == -1) {
+         printf("wait: failed to DRM_IOCTL_TEGRA_SYNCPOINT_WAIT: %d\n", errno);
+         return VK_ERROR_UNKNOWN;
+      }
+
+      sobj->initialized = false; // reset
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_nvgpu_sync_import_opaque_fd(struct vk_device *device,
+                                struct vk_sync *sync,
+                                int fd)
+{
+   return vk_errorf(device, VK_ERROR_UNKNOWN,
+                    "sync_import_opaque_fd: not implemented");
+}
+
+static VkResult
+nvkmd_nvgpu_sync_export_opaque_fd(struct vk_device *device,
+                                struct vk_sync *sync,
+                                int *fd)
+{
+   return vk_errorf(device, VK_ERROR_UNKNOWN,
+                    "sync_export_opaque_fd: not implemented");
+}
+
+static VkResult
+nvkmd_nvgpu_sync_move(struct vk_device *device,
+                    struct vk_sync *dst,
+                    struct vk_sync *src)
+{
+   return vk_errorf(device, VK_ERROR_UNKNOWN,
+                    "nvkmd_nvgpu_sync_move: not implemented");
+}
+
+
+struct vk_sync_type
+nvkmd_nvgpu_sync_get_type(struct nvkmd_nvgpu_pdev *pdev)
+{
+   struct vk_sync_type type = {
+      .size = sizeof(struct nvkmd_nvgpu_sync),
+      .features = VK_SYNC_FEATURE_BINARY |
+                  VK_SYNC_FEATURE_GPU_WAIT |
+                  VK_SYNC_FEATURE_CPU_RESET |
+                  VK_SYNC_FEATURE_CPU_SIGNAL |
+                  VK_SYNC_FEATURE_WAIT_PENDING |
+                  VK_SYNC_FEATURE_CPU_WAIT |
+                  VK_SYNC_FEATURE_TIMELINE,
+      .init = nvkmd_nvgpu_sync_init,
+      .finish = nvkmd_nvgpu_sync_finish,
+      .signal = nvkmd_nvgpu_sync_signal,
+      .get_value = nvkmd_nvgpu_sync_get_value,
+      .reset = nvkmd_nvgpu_sync_reset,
+      .move = nvkmd_nvgpu_sync_move,
+      .wait_many = nvkmd_nvgpu_sync_wait_many,
+      .import_opaque_fd = nvkmd_nvgpu_sync_import_opaque_fd,
+      .export_opaque_fd = nvkmd_nvgpu_sync_export_opaque_fd,
+   };
+   return type;
+}
diff --git a/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_va.c b/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_va.c
