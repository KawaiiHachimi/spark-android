+NVKMD_DECL_SUBCLASS(ctx, nvgpu_bind);
+
+VkResult nvkmd_nvgpu_create_ctx(struct nvkmd_dev *dev,
+                                  struct vk_object_base *log_obj,
+                                  enum nvkmd_engines engines,
+                                  struct nvkmd_ctx **ctx_out);
+
+struct nvkmd_nvgpu_sync {
+   struct vk_sync base;
+
+   bool initialized;
+   uint32_t syncpoint_id;
+
+   int64_t local_offset; // offset from drm value to logical value
+};
+
+void
+nvkmd_nvgpu_sync_finish(struct vk_device *device,
+                       struct vk_sync *sync);
+
+static inline bool
+vk_sync_type_is_nvkmd_nvgpu_sync(const struct vk_sync_type *type)
+{
+   return type->finish == nvkmd_nvgpu_sync_finish;
+}
+
+static inline struct nvkmd_nvgpu_sync *
+vk_sync_as_nvgpu_sync(struct vk_sync *sync)
+{
+   if (!vk_sync_type_is_nvkmd_nvgpu_sync(sync->type))
+      return NULL;
+
+   return container_of(sync, struct nvkmd_nvgpu_sync, base);
+}
+
+struct vk_sync_type
+nvkmd_nvgpu_sync_get_type(struct nvkmd_nvgpu_pdev *pdev);
+
+
+static inline int nvgpu_ioctl(int fd, int num, void* ptr) {
+   while(true) {
+      if (ioctl(fd, num, ptr) == -1) {
+         if (errno == EAGAIN) {
+            continue;
+         }
+         return -1;
+      }
+      return 0;
+   }
+}
