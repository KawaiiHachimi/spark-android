+static VkResult
+nvkmd_nvgpu_exec_ctx_flush_impl(struct nvkmd_ctx *_ctx,
+                             struct vk_object_base *log_obj,
+                             struct nvgpu_fence *fence_out
+                           )
+{
+   struct nvkmd_nvgpu_exec_ctx *ctx = nvkmd_nvgpu_exec_ctx(_ctx);
+   
+   // if (ctx->req.push_count == 0 &&
+   //     ctx->req.wait_count == 0 &&
+   //     ctx->req.sig_count == 0)
+   //    return VK_SUCCESS;
+
+   // int err = drmCommandWriteRead(ctx->ws_dev->fd, DRM_nvgpu_EXEC,
+   //                               &ctx->req, sizeof(ctx->req));
+   // if (err) {
+   //    VkResult result = VK_ERROR_UNKNOWN;
+   //    if (err == -ENODEV)
+   //       result = VK_ERROR_DEVICE_LOST;
+   //    return vk_errorf(log_obj, result, "DRM_nvgpu_EXEC failed: %m");
+   // }
+
+   // ctx->req.push_count = 0;
+   // ctx->req.wait_count = 0;
+   // ctx->req.sig_count = 0;
+
+   // return VK_SUCCESS;
+
+   __u32 flags = NVGPU_SUBMIT_GPFIFO_FLAGS_HW_FORMAT; // nvidia sets HW_FORMAT, not exactly sure what it does;
+   if (ctx->is_fence_filled) {
+      flags |= NVGPU_SUBMIT_GPFIFO_FLAGS_FENCE_WAIT;
+   }
+   if (fence_out != NULL) {
+      flags |= NVGPU_SUBMIT_GPFIFO_FLAGS_FENCE_GET;
+   }
+
+   struct nvgpu_submit_gpfifo_args submit_args = {
+      .gpfifo = (__u64)ctx->gp_fifo->map,
+      .num_entries = ctx->push_count,
+      .flags = flags,
+      .fence = ctx->fence,
+   };
+   if (nvgpu_ioctl(ctx->channel_fd, NVGPU_IOCTL_CHANNEL_SUBMIT_GPFIFO, &submit_args) == -1) {
+      printf("failed to NVGPU_IOCTL_CHANNEL_SUBMIT_GPFIFO %d (%s)\n", errno, strerror(errno));
+      return VK_ERROR_UNKNOWN;
+   }
+   ctx->push_count = 0; 
+   ctx->is_fence_filled = false;
+
+   if (fence_out != NULL) {
+      *fence_out = submit_args.fence;
+   }
+
+   return VK_SUCCESS;
