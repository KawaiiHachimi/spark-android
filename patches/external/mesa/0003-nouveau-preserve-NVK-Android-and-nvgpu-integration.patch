+static VkResult
+nvkmd_nvgpu_exec_ctx_signal(struct nvkmd_ctx *_ctx,
+                              struct vk_object_base *log_obj,
+                              uint32_t signal_count,
+                              const struct vk_sync_signal *signals)
+{
+   struct nvkmd_nvgpu_exec_ctx *ctx = nvkmd_nvgpu_exec_ctx(_ctx);
+
+   struct nvgpu_fence fence;
+   VkResult res = nvkmd_nvgpu_exec_ctx_flush_impl(&ctx->base, log_obj, signal_count == 0 ? NULL : &fence);
+   if (res != VK_SUCCESS) { return res; }
+
+   if (signal_count != 0) {
+      for (uint32_t i = 0; i < signal_count; i++) {
+         struct nvkmd_nvgpu_sync *sobj = vk_sync_as_nvgpu_sync(signals[i].sync);
+         // assert(!sobj->initialized); this seems to get hit, not sure if OK
+
+         // if (sobj->base.flags & VK_SYNC_IS_TIMELINE) {
+         // printf("(vk=%p nv=%d tl=%d) submitted--nv.value=%d vk.value=%lu\n", signals[i].sync, fence.id, sobj->base.flags & VK_SYNC_IS_TIMELINE, fence.value, signals[i].signal_value);
+            sobj->local_offset = signals[i].signal_value - fence.value ; // maybe??
+         // }
+
+         sobj->initialized = true;
+         sobj->syncpoint_id = fence.id;
+         // signals[i].signal_value = fence.value;
+      }
+   }
+
+   return VK_SUCCESS;
+}
