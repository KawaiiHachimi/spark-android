+
+static VkResult
+nvkmd_nvgpu_va_unbind(struct nvkmd_va *_va,
+                        struct vk_object_base *log_obj,
+                        uint64_t va_offset_B,
+                        uint64_t range_B);
+
+static void
+free_heap_addr(struct nvkmd_nvgpu_dev *dev,
+               enum nvkmd_va_flags flags,
+               uint64_t addr, uint64_t size_B)
+{
+   simple_mtx_lock(&dev->heap_mutex);
+   if (flags & NVKMD_VA_REPLAY) {
+      assert(addr >= NVKMD_NVGPU_REPLAY_HEAP_START);
+      assert(addr <= NVKMD_NVGPU_REPLAY_HEAP_END);
+      assert(addr + size_B <= NVKMD_NVGPU_REPLAY_HEAP_END);
+
+      util_vma_heap_free(&dev->replay_heap, addr, size_B);
+   } else {
+      assert(addr >= NVKMD_NVGPU_HEAP_START);
+      assert(addr <= NVKMD_NVGPU_HEAP_END);
+      assert(addr + size_B <= NVKMD_NVGPU_HEAP_END);
+
+      util_vma_heap_free(&dev->heap, addr, size_B);
+   }
+   simple_mtx_unlock(&dev->heap_mutex);
+}
+
+static VkResult MUST_CHECK
+vm_bind(struct nvkmd_nvgpu_dev *dev,
+        struct vk_object_base *log_obj,
+        struct drm_nvgpu_vm_bind_op *op)
+{
+   // struct drm_nvgpu_vm_bind vmbind = {
+   //    .op_count = 1,
+   //    .op_ptr = (uint64_t)(uintptr_t)(void *)op,
+   // };
+   // int err = drmCommandWriteRead(dev->ws_dev->fd, DRM_nvgpu_VM_BIND,
+   //                               &vmbind, sizeof(vmbind));
+   // if (err)
+   //    return vk_errorf(log_obj, VK_ERROR_UNKNOWN, "vm_bind failed: %m");
+
+   // return VK_SUCCESS;
+
+   printf("unimpl: vm_bind\n");
+   return VK_ERROR_OUT_OF_HOST_MEMORY;
+}
+
+static VkResult MUST_CHECK
+alloc_heap_addr_locked(struct nvkmd_nvgpu_dev *dev,
+                       struct vk_object_base *log_obj,
+                       enum nvkmd_va_flags flags,
+                       uint64_t size_B, uint64_t align_B,
+                       uint64_t fixed_addr, uint64_t *addr_out)
+{
+   if (flags & NVKMD_VA_ALLOC_FIXED) {
+      assert(flags & NVKMD_VA_REPLAY);
+      if (fixed_addr < NVKMD_NVGPU_REPLAY_HEAP_START ||
+          fixed_addr >= NVKMD_NVGPU_REPLAY_HEAP_END) {
+         return vk_errorf(log_obj, VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS,
+                          "Capture address 0x%" PRIx64 " not in the reaplay "
+                          "heap address range [0x%" PRIx64 ", 0x%" PRIx64 ")",
+                          fixed_addr, NVKMD_NVGPU_REPLAY_HEAP_START,
+                          NVKMD_NVGPU_REPLAY_HEAP_END);
+      }
+
+      if (fixed_addr & (align_B - 1)) {
+         return vk_errorf(log_obj, VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS,
+                          "Unaligned capture address: 0x%" PRIx64, fixed_addr);
+      }
+
+      if (!util_vma_heap_alloc_addr(&dev->replay_heap, fixed_addr, size_B)) {
+         return vk_errorf(log_obj, VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS,
+                          "Replay address collision: 0x%" PRIx64, fixed_addr);
+      }
+
+      *addr_out = fixed_addr;
+   } else if (flags & NVKMD_VA_REPLAY) {
+      *addr_out = util_vma_heap_alloc(&dev->replay_heap, size_B, align_B);
+      if (*addr_out == 0)
+         return vk_errorf(log_obj, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                          "Failed to allocate virtual address range");
+   } else {
+      *addr_out = util_vma_heap_alloc(&dev->heap, size_B, align_B);
+      if (*addr_out == 0)
+         return vk_errorf(log_obj, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                          "Failed to allocate virtual address range");
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult MUST_CHECK
+alloc_heap_addr(struct nvkmd_nvgpu_dev *dev,
+                struct vk_object_base *log_obj,
+                enum nvkmd_va_flags flags,
+                uint64_t size_B, uint64_t align_B,
+                uint64_t fixed_addr, uint64_t *addr_out)
+{
+   simple_mtx_lock(&dev->heap_mutex);
+   VkResult result = alloc_heap_addr_locked(dev, log_obj, flags,
+                                            size_B, align_B,
+                                            fixed_addr, addr_out);
+   simple_mtx_unlock(&dev->heap_mutex);
+   return result;
+}
+
+VkResult
+nvkmd_nvgpu_alloc_va(struct nvkmd_dev *_dev,
+                       struct vk_object_base *log_obj,
+                       enum nvkmd_va_flags flags, uint8_t pte_kind,
+                       uint64_t size_B, uint64_t align_B,
+                       uint64_t fixed_addr, struct nvkmd_va **va_out)
+{
+   struct nvkmd_nvgpu_dev *dev = nvkmd_nvgpu_dev(_dev);
+   VkResult result;
+
+   assert((flags & NVKMD_VA_ALLOC_FIXED) == 0); // unimpl
+   assert((flags & NVKMD_VA_GART) == 0); // unimpl
+   assert((flags & NVKMD_VA_SPARSE) == 0); // unimpl
+   assert((flags & NVKMD_VA_REPLAY) == 0); // unimpl
+
+   struct nvkmd_nvgpu_va *va = CALLOC_STRUCT(nvkmd_nvgpu_va);
+   if (va == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   const uint32_t min_align_B = _dev->pdev->bind_align_B;
+   size_B = align64(size_B, min_align_B);
+
+   assert(util_is_power_of_two_or_zero64(align_B));
+   align_B = MAX2(align_B, min_align_B);
+
+   result = alloc_heap_addr(dev, log_obj, flags, size_B, align_B,
+                           fixed_addr, &va->base.addr);
+   if (result != VK_SUCCESS)
+      return result;
+
+   assert((fixed_addr == 0) == !(flags & NVKMD_VA_ALLOC_FIXED));
+
+   va->base.ops = &nvkmd_nvgpu_va_ops;
+   va->base.dev = &dev->base;
+   va->base.flags = flags;
+   va->base.pte_kind = pte_kind;
+   va->base.size_B = size_B;
+
+   struct nvgpu_as_alloc_space_args alloc_space_args = {
+      .pages = size_B / 4096, // xxx
+      .page_size = 4096,
+      .flags = NVGPU_AS_ALLOC_SPACE_FLAGS_FIXED_OFFSET,
+      .o_a.offset = va->base.addr,
+   };
+   if (ioctl(dev->heap_as_fd, NVGPU_AS_IOCTL_ALLOC_SPACE, &alloc_space_args) == -1) {
+      printf("failed NVGPU32_AS_IOCTL_ALLOC_SPACE: %d\n", errno);
+      return VK_ERROR_UNKNOWN;
+   }
+   *va_out = &va->base;
+
+   return VK_SUCCESS;
+}
+
+static void
+nvkmd_nvgpu_va_free(struct nvkmd_va *_va)
+{
+   struct nvkmd_nvgpu_dev *dev = nvkmd_nvgpu_dev(_va->dev);
+   struct nvkmd_nvgpu_va *va = nvkmd_nvgpu_va(_va);
+   // VkResult result = VK_SUCCESS;
+
+
+   // unbind all current binds
+   for (int i = 0; i < va->binds_size; ++i) {
+      VkResult res = nvkmd_nvgpu_va_unbind(_va, NULL, va->binds[i].offset, va->binds[i].size);
+      assert(res == VK_SUCCESS);
+   }
+
+   // printf("unimpl: nvkmd_nvgpu_va_free\n");
+   struct nvgpu_as_free_space_args free_space_args = {
+      .offset = va->base.addr,
+      .pages = va->base.size_B / 4096,
+      .page_size = 4096,
+   };
+   if (ioctl(dev->heap_as_fd, NVGPU_AS_IOCTL_FREE_SPACE, &free_space_args) == -1) {
+      printf("failed NVGPU_AS_IOCTL_FREE_SPACE %d\n", errno);
+   }
+   free_heap_addr(dev, va->base.flags, va->base.addr, va->base.size_B);
+   
+   if (va->binds != NULL) {
+      FREE(va->binds);
+   }
+   FREE(va);
+
+   // STATIC_ASSERT(VK_SUCCESS == 0);
+
+   // {
+   //    struct drm_nvgpu_vm_bind_op bind = {
+   //       .op = DRM_nvgpu_VM_BIND_OP_UNMAP,
+   //       .addr = va->base.addr,
+   //       .range = va->base.size_B,
+   //    };
+   //    result |= vm_bind(dev, NULL, &bind);
+   // }
+
+   // if (va->base.flags & NVKMD_VA_SPARSE) {
+   //    struct drm_nvgpu_vm_bind_op bind = {
+   //       .op = DRM_nvgpu_VM_BIND_OP_UNMAP,
+   //       .addr = va->base.addr,
+   //       .range = va->base.size_B,
+   //       .flags = DRM_nvgpu_VM_BIND_SPARSE,
+   //    };
+   //    result |= vm_bind(dev, NULL, &bind);
+   // }
+
+   // /* If unbinding fails, we leak the VA range */
+   // if (result == VK_SUCCESS)
+   //    free_heap_addr(dev, va->base.flags, va->base.addr, va->base.size_B);
+
+   // FREE(va);
+}
+
+static VkResult
+nvkmd_nvgpu_va_bind_mem(struct nvkmd_va *_va,
+                          struct vk_object_base *log_obj,
+                          uint64_t va_offset_B,
+                          struct nvkmd_mem *_mem,
+                          uint64_t mem_offset_B,
+                          uint64_t range_B)
+{
+   struct nvkmd_nvgpu_dev *dev = nvkmd_nvgpu_dev(_va->dev);
+   struct nvkmd_nvgpu_va *va = nvkmd_nvgpu_va(_va);
+   struct nvkmd_nvgpu_mem *mem = nvkmd_nvgpu_mem(_mem);
+
+   // assert(_mem->dev == _va->dev);
+
+   // struct drm_nvgpu_vm_bind_op bind = {
+   //    .op = DRM_nvgpu_VM_BIND_OP_MAP,
+   //    .handle = mem->bo->handle,
+   //    .addr = va->base.addr + va_offset_B,
+   //    .range = range_B,
+   //    .bo_offset = mem_offset_B,
+   //    .flags = va->base.pte_kind,
+   // };
+   // return vm_bind(dev, log_obj, &bind);
+
+   struct nvmap_create_handle get_fd_args = {
+      .handle = mem->nvmap_handle,
+   };
+   if (ioctl(dev->nvmap_fd, NVMAP_IOC_GET_FD, &get_fd_args) == -1) {
+      printf("failed to NVMAP_IOC_GET_FD: %d\n", errno);
+      return VK_ERROR_UNKNOWN;
+   }
+
+   // mmap(NULL, range_B, get_fd_args.fd, )
+   
+   
+   __u32 flags = NVGPU_AS_MAP_BUFFER_FLAGS_FIXED_OFFSET | NVGPU_AS_MAP_BUFFER_FLAGS_CACHEABLE;
+   if (mem->base.flags & NVKMD_MEM_COHERENT)
+      flags |= NVGPU_AS_MAP_BUFFER_FLAGS_SYSTEM_COHERENT;
+
+   struct nvgpu_as_map_buffer_ex_args map_buffer_args = {
+      .flags = flags,
+      .compr_kind = NV_KIND_INVALID,
+      .incompr_kind = va->base.pte_kind,
+      .dmabuf_fd = get_fd_args.fd,
+      .page_size = 4096, // xxx
+      .buffer_offset = mem_offset_B,
+      .mapping_size = range_B,
+      .offset = va->base.addr + va_offset_B,
+   };
+   if (ioctl(dev->heap_as_fd, NVGPU_AS_IOCTL_MAP_BUFFER_EX, &map_buffer_args) == -1) {
+      printf("failed to NVGPU_AS_IOCTL_MAP_BUFFER_EX: %d\n", errno);
+      return VK_ERROR_UNKNOWN;
+   }
+
+   close(get_fd_args.fd);
+
+   if (va->binds_size == va->binds_capacity) {
+      va->binds_capacity = (va->binds_capacity + 1) * 2;
+      va->binds = realloc(va->binds, sizeof(*va->binds) * va->binds_capacity);
+   }
+   va->binds[va->binds_size] = (struct nvkmd_nvgpu_bind) {
+      .offset = va_offset_B,
+      .size = range_B,
+   };
+   ++va->binds_size;
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_nvgpu_va_unbind(struct nvkmd_va *_va,
+                        struct vk_object_base *log_obj,
+                        uint64_t va_offset_B,
+                        uint64_t range_B)
+{
+   struct nvkmd_nvgpu_dev *dev = nvkmd_nvgpu_dev(_va->dev);
+   struct nvkmd_nvgpu_va *va = nvkmd_nvgpu_va(_va);
+
+   int bind_id = -1;
+   for (int i = 0; i < va->binds_size; ++i) {
+      if (va->binds[i].offset == va_offset_B) {
+         bind_id = i;
+         break;
+      }
+   }
+
+   assert(bind_id != -1);
+   // NOTE: ranges must match for this to be correct. maybe we need to unbind & rebind if ranges don't match?
+   assert(va->binds[bind_id].size == range_B);
+
+   struct nvgpu_as_unmap_buffer_args unmap_args = {
+      .offset = va->base.addr + va_offset_B
+   };
+   if (ioctl(dev->heap_as_fd, NVGPU_AS_IOCTL_UNMAP_BUFFER, &unmap_args) == -1) {
+      printf("failed to unmap: %d\n", errno);
+   }
+
+   // remove from binds list
+   if (bind_id + 1 != va->binds_size) {
+      memcpy(&va->binds[bind_id], &va->binds[va->binds_size - 1], sizeof(va->binds[0]));
+   }
+   --va->binds_size;
+
+   return VK_SUCCESS;
+}
+
+const struct nvkmd_va_ops nvkmd_nvgpu_va_ops = {
+   .free = nvkmd_nvgpu_va_free,
+   .bind_mem = nvkmd_nvgpu_va_bind_mem,
+   .unbind = nvkmd_nvgpu_va_unbind,
+};
