+
+#define NVMAP_HEAP_IOVMM   (1ul<<30)
+
+#define NVMAP_HEAP_CARVEOUT_VPR     (1ul<<28)
+#define NVMAP_HEAP_CARVEOUT_TSEC    (1ul<<27)
+#define NVMAP_HEAP_CARVEOUT_VIDMEM  (1ul<<26)
+#define NVMAP_HEAP_CARVEOUT_GPU (1ul << 3)
+#define NVMAP_HEAP_CARVEOUT_FSI   (1ul<<2)
+#define NVMAP_HEAP_CARVEOUT_IVM     (1ul<<1)
+#define NVMAP_HEAP_CARVEOUT_GENERIC (1ul<<0)
+
+/* allocation flags */
+#define NVMAP_HANDLE_UNCACHEABLE     (0x0ul << 0)
+#define NVMAP_HANDLE_WRITE_COMBINE   (0x1ul << 0)
+#define NVMAP_HANDLE_INNER_CACHEABLE (0x2ul << 0)
+#define NVMAP_HANDLE_CACHEABLE       (0x3ul << 0)
+#define NVMAP_HANDLE_CACHE_FLAG      (0x3ul << 0)
+
+#define NVMAP_HANDLE_SECURE          (0x1ul << 2)
+#define NVMAP_HANDLE_KIND_SPECIFIED  (0x1ul << 3)
+#define NVMAP_HANDLE_COMPR_SPECIFIED (0x1ul << 4)
+#define NVMAP_HANDLE_ZEROED_PAGES    (0x1ul << 5)
+#define NVMAP_HANDLE_PHYS_CONTIG     (0x1ul << 6)
+#define NVMAP_HANDLE_CACHE_SYNC      (0x1ul << 7)
+#define NVMAP_HANDLE_CACHE_SYNC_AT_RESERVE      (0x1ul << 8)
+#define NVMAP_HANDLE_RO	             (0x1ul << 9)
+
+VkResult
+nvkmd_nvgpu_alloc_mem(struct nvkmd_dev *dev,
+                        struct vk_object_base *log_obj,
+                        uint64_t size_B, uint64_t align_B,
+                        enum nvkmd_mem_flags flags,
+                        struct nvkmd_mem **mem_out)
+{
+   return nvkmd_nvgpu_alloc_tiled_mem(dev, log_obj, size_B, align_B,
+                                        0 /* pte_kind */, 0 /* tile_mode */,
+                                        flags, mem_out);
+}
+
+static VkResult
+create_mem_or_close_bo(struct nvkmd_nvgpu_dev *dev,
+                       struct vk_object_base *log_obj,
+                       enum nvkmd_mem_flags mem_flags,
+                       uint32_t nvmap_handle, uint64_t size_B,
+                       enum nvkmd_va_flags va_flags,
+                       uint8_t pte_kind, uint64_t va_align_B,
+                       struct nvkmd_mem **mem_out)
+{
+   // const uint64_t size_B = bo->size;
+   VkResult result;
+
+   struct nvkmd_nvgpu_mem *mem = CALLOC_STRUCT(nvkmd_nvgpu_mem);
+   if (mem == NULL) {
+      result = vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+      goto fail_bo;
+   }
+
+   nvkmd_mem_init(&dev->base, &mem->base, &nvkmd_nvgpu_mem_ops,
+                  mem_flags, size_B, dev->base.pdev->bind_align_B);
+   mem->nvmap_handle = nvmap_handle;
+
+   result = nvkmd_dev_alloc_va(&dev->base, log_obj,
+                               va_flags, pte_kind,
+                               size_B, va_align_B,
+                               0 /* fixed_addr */,
+                               &mem->base.va);
+   if (result != VK_SUCCESS)
+      goto fail_mem;
+
+   result = nvkmd_va_bind_mem(mem->base.va, log_obj, 0 /* va_offset_B */,
+                              &mem->base, 0 /* mem_offset_B */, size_B);
+   if (result != VK_SUCCESS)
+      goto fail_va;
+
+   *mem_out = &mem->base;
+
+   return VK_SUCCESS;
+
+fail_va:
+   nvkmd_va_free(mem->base.va);
+fail_mem:
+   FREE(mem);
+fail_bo:
+   // nvgpu_ws_bo_destroy(bo); xxx: free!!
+
+   return result;
+}
+
+VkResult
+nvkmd_nvgpu_alloc_tiled_mem(struct nvkmd_dev *_dev,
+                              struct vk_object_base *log_obj,
+                              uint64_t size_B, uint64_t align_B,
+                              uint8_t pte_kind, uint16_t tile_mode,
+                              enum nvkmd_mem_flags flags,
+                              struct nvkmd_mem **mem_out)
+{
+   struct nvkmd_nvgpu_dev *dev = nvkmd_nvgpu_dev(_dev);
+   const struct nv_device_info *dev_info = &dev->base.pdev->dev_info;
+
+   /* Only one placement flag may be specified */
+   assert(util_bitcount(flags & (NVKMD_MEM_LOCAL |
+                                 NVKMD_MEM_GART |
+                                 NVKMD_MEM_VRAM)) == 1);
+
+   if (tile_mode != 0) {
+      printf("unimpl tile mode=%d\n", tile_mode);
+   }
+
+                                 // XXX: i think this was wrong
+   // void* addr = mmap(NULL, size_B, PROT_READ|PROT_WRITE, MAP_SHARED, dev->ctrl_fd, 0);
+   // if (addr == NULL) {
+   //    return VK_ERROR_OUT_OF_HOST_MEMORY;
+   // }
+
+   const uint32_t mem_align_B = _dev->pdev->bind_align_B;
+   size_B = align64(size_B, mem_align_B);
+
+   assert(util_is_power_of_two_or_zero64(align_B));
+   const uint64_t va_align_B = MAX2(mem_align_B, align_B);
+
+   struct nvmap_create_handle create_args = {
+      .size = size_B,
+   };
+   if (ioctl(dev->nvmap_fd, NVMAP_IOC_CREATE, &create_args) == -1) {
+      printf("filed to NVMAP_IOC_CREATE: %d\n", errno);
+      return VK_ERROR_UNKNOWN;
+   }
+
+   uint32_t handle = create_args.handle;
+
+   uint32_t heap_mask = 0;
+   // if (flags & NVKMD_MEM_LOCAL) { xxx
+   //    heap_mask |= NVMAP_HEAP_CARVEOUT_GENERIC;
+   //    if (dev_info->vram_size_B > 0)
+   //       heap_mask |= NVMAP_HEAP_CARVEOUT_GPU;
+   // } else if (flags & NVKMD_MEM_GART) {
+   //    heap_mask |= NVMAP_HEAP_CARVEOUT_GENERIC; // xxx
+   // } else if (flags & NVKMD_MEM_VRAM) {
+   //    heap_mask |= NVMAP_HEAP_CARVEOUT_GPU;
+   // }
+
+   heap_mask = NVMAP_HEAP_IOVMM;
+
+   // 1002 is the memory tag. this is what nvidia gives it, shurg
+   uint32_t alloc_flags = (0x1002 << 16) | NVMAP_HANDLE_CACHEABLE; // xxx
+
+   struct nvmap_alloc_handle alloc_args = {
+      .handle = handle,
+      .heap_mask = heap_mask,
+      .flags = alloc_flags,
+      .align = va_align_B,
+      .numa_nid = -1,
+   };
+   if (ioctl(dev->nvmap_fd, NVMAP_IOC_ALLOC, &alloc_args) == -1) {
+      printf("failed to NVMAP_IOC_ALLOC: %d\n", errno);
+      return VK_ERROR_UNKNOWN;
+   }
+
+   struct nvmap_create_handle get_fd_args = {
+      .handle = handle,
+   };
+   if (ioctl(dev->nvmap_fd, NVMAP_IOC_GET_FD, &get_fd_args) == -1) {
+      printf("failed to NVMAP_IOC_GET_FD: %d\n", errno);
+      return VK_ERROR_UNKNOWN;
+   }
+
+   struct nvgpu_gpu_register_buffer_args register_args = {
+      .dmabuf_fd = get_fd_args.fd,
+   };
+   if (ioctl(dev->ctrl_fd, NVGPU_GPU_IOCTL_REGISTER_BUFFER, &register_args) == -1) {
+      printf("failed to NVGPU_GPU_IOCTL_REGISTER_BUFFER: %d\n", errno);
+      return VK_ERROR_UNKNOWN;
+   }
+   close(get_fd_args.fd);
+
+
+   // if (dev->base.pdev->debug_flags & NVK_DEBUG_FORCE_GART)
+   //    domains = nvgpu_WS_BO_GART;
+
+   // /* TODO:
+   //  *
+   //  * VRAM maps on Kepler appear to be broken and we don't really know why.
+   //  * My NVIDIA contact doesn't remember them not working so they probably
+   //  * should but they don't today.  Force everything that may be mapped to
+   //  * use GART for now.
+   //  */
+   // if (dev_info->chipset < 0x110 && (flags & nvgpu_WS_BO_MAP)) {
+   //    assert(domains & nvgpu_WS_BO_GART);
+   //    domains = nvgpu_WS_BO_GART;
+   // }
+
+   // enum nvgpu_ws_bo_flags nvgpu_flags = domains;
+   // if (flags & NVKMD_MEM_CAN_MAP)
+   //    nvgpu_flags |= nvgpu_WS_BO_MAP;
+   // if (!(flags & NVKMD_MEM_SHARED))
+   //    nvgpu_flags |= nvgpu_WS_BO_NO_SHARE;
+
+   // struct nvgpu_ws_bo *bo = nvgpu_ws_bo_new_tiled(dev->ws_dev,
+   //                                                    size_B, mem_align_B,
+   //                                                    pte_kind, tile_mode,
+   //                                                    nvgpu_flags);
+   // if (bo == NULL)
+   //    return vk_errorf(log_obj, VK_ERROR_OUT_OF_DEVICE_MEMORY, "%m");
+
+   enum nvkmd_va_flags va_flags = 0; // XXX
+   // if (domains == nvgpu_WS_BO_GART)
+   //    va_flags |= NVKMD_VA_GART;
+
+   return create_mem_or_close_bo(dev, log_obj, flags, handle, size_B,
+                                 va_flags, pte_kind, va_align_B,
+                                 mem_out);
+}
+
+VkResult
+nvkmd_nvgpu_import_dma_buf(struct nvkmd_dev *_dev,
+                             struct vk_object_base *log_obj,
+                             int fd, struct nvkmd_mem **mem_out)
+{
+   struct nvkmd_nvgpu_dev *dev = nvkmd_nvgpu_dev(_dev);
