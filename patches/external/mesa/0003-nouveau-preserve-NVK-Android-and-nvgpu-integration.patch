+static VkResult
+nvkmd_nvgpu_exec_ctx_exec(struct nvkmd_ctx *_ctx,
+                            struct vk_object_base *log_obj,
+                            uint32_t exec_count,
+                            const struct nvkmd_ctx_exec *execs)
+{
+   struct nvkmd_nvgpu_exec_ctx *ctx = nvkmd_nvgpu_exec_ctx(_ctx);
+
+   for (uint32_t i = 0; i < exec_count; i++) {
+      if (unlikely(ctx->push_count >= NVGPU_GPFIFO_SIZE)) {
+         VkResult result = nvkmd_nvgpu_exec_ctx_flush(&ctx->base, log_obj);
+         if (result != VK_SUCCESS)
+            return result;
+      }
+
+      /* This is the hardware limit on all current GPUs */
+      assert((execs[i].addr % 4) == 0 && (execs[i].size_B % 4) == 0);
+      assert(execs[i].size_B < (1u << 23));
+
+      // insert into gpfifo
+      struct nvgpu_gpfifo *fifo_ptr = (struct nvgpu_gpfifo*)ctx->gp_fifo->map;
+
+      #define DRF_ISBIT(bitval,drf)                \
+        ( /* coverity[identical_branches] */ \
+          (bitval != 0) ? drf )
+      #define DRF_SHIFT(drf)          ((DRF_ISBIT(0,drf)) % 32)
+      #define DRF_NUM(d,r,f,n)        ((((NvU32)(n))&DRF_MASK(NV ## d ## r ## f))<<DRF_SHIFT(NV ## d ## r ## f))
+      #define DRF_MASK(drf)           (0xFFFFFFFFU>>(31-((DRF_ISBIT(1,drf)) % 32)+((DRF_ISBIT(0,drf)) % 32)))
+
+      fifo_ptr[ctx->push_count].entry0 = DRF_NUM(A16F, _GP_ENTRY0, _GET, (execs[i].addr & 0xffffffff) >> 2);
+      fifo_ptr[ctx->push_count].entry1 =
+         DRF_NUM(A16F, _GP_ENTRY1, _GET_HI, ((execs[i].addr >> 32) & 0xffffffff)) |
+         DRF_NUM(A16F, _GP_ENTRY1, _LENGTH, (execs[i].size_B >> 2)) |
+         DRF_NUM(A16F, _GP_ENTRY1, _SYNC, (execs[i].no_prefetch ? NVA16F_GP_ENTRY1_SYNC_WAIT : NVA16F_GP_ENTRY1_SYNC_PROCEED));
+
+      ctx->push_count = (ctx->push_count + 1) % NVGPU_GPFIFO_SIZE;
+   }
+
+   return VK_SUCCESS;
+}
